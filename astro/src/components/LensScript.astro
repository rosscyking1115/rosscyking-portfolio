---
import { DEFAULT_LENS, LENS_ALIASES, LENS_KEYS } from "../lib/lenses";

/**
 * Applies the `?lens=` query parameter before first paint (migration risk #6).
 *
 * The Next app read `searchParams` in a server component and rendered the right
 * featured set. A prerendered Astro page cannot — the same HTML is served to
 * everyone — so every lens panel is prerendered and CSS picks the visible one
 * off `data-lens` on <html>.
 *
 * This runs inline in <head>, for the same reason as ThemeScript: a bundled
 * script is deferred and would run after first paint, so a visitor opening a
 * shared /?lens=ai link would see the default lens flash first.
 *
 * The valid keys are injected from the registry at build time rather than
 * hardcoded, so adding a lens cannot leave this behind.
 *
 * The `/for/:lens` -> `/?lens=:lens` redirect that feeds this lives in
 * vercel.json, because Astro cannot express a query-string destination — it
 * fails the build with InvalidRedirectDestination. vercel.json permits no
 * comments and no unknown keys, so the reasoning is recorded here and in
 * tests/e2e/redirects.spec.ts instead.
 *
 * Retired lens names are mapped onto the surviving lens that answers the same
 * role (see LENS_ALIASES) rather than dumped on the default. Genuine nonsense
 * still falls back. Both the key list and the alias map are injected from the
 * registry at build time, so neither can be left behind.
 */
const keys = JSON.stringify(LENS_KEYS);
const aliases = JSON.stringify(LENS_ALIASES);
---

<script is:inline define:vars={{ keys, aliases, defaultLens: DEFAULT_LENS }}>
  (function () {
    try {
      var valid = JSON.parse(keys);
      var aliasMap = JSON.parse(aliases);
      var requested = new URLSearchParams(window.location.search).get("lens");

      var lens = defaultLens;
      if (requested) {
        if (valid.indexOf(requested) > -1) lens = requested;
        else if (Object.prototype.hasOwnProperty.call(aliasMap, requested))
          lens = aliasMap[requested];
      }

      document.documentElement.dataset.lens = lens;
    } catch (error) {
      document.documentElement.dataset.lens = defaultLens;
    }
  })();
</script>
