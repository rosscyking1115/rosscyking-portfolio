---
import { ContactForm } from "../components/ContactForm";
import Base from "../layouts/Base.astro";

/**
 * The one route in the whole site that is NOT prerendered.
 *
 * Astro Actions called from a form require on-demand rendering, and
 * on-demand rendering requires an adapter — hence @astrojs/vercel in
 * astro.config.mjs. Everything else stays static.
 *   https://docs.astro.build/en/guides/actions/
 *   https://docs.astro.build/en/guides/on-demand-rendering/
 */
export const prerender = false;

// Copy ported verbatim from src/app/contact/page.tsx — not rewritten.
const email = "rosscyking@gmail.com";
const github = "https://github.com/rosscyking1115";
const linkedin = "https://www.linkedin.com/in/rosscyking";
const availability = "Available for full-time roles from Oct 2026";

const strip = (url: string) => url.replace(/^https?:\/\/(www\.)?/, "");

const links = [
  { label: "Email", value: email, href: `mailto:${email}` },
  { label: "GitHub", value: strip(github), href: github, external: true },
  { label: "LinkedIn", value: strip(linkedin), href: linkedin, external: true },
  { label: "Download CV", value: "PDF", href: "/cv.pdf", download: "Cheng-Yuan-King-CV.pdf" },
];
---

<Base
  title="Contact"
  description="Get in touch about applied AI, GenAI evaluation, data science, and AI safety roles in the UK. Replies usually within a couple of days."
  canonical="/contact"
>
  <div class="grid gap-12 lg:grid-cols-[1fr_1.1fr]">
    <div class="max-w-prose">
      <h1 class="font-display mt-4 text-4xl font-bold tracking-tight sm:text-5xl">
        Let&rsquo;s talk.
      </h1>
      <p class="text-muted-foreground mt-4 text-lg leading-relaxed text-pretty">
        I&rsquo;m looking for 2026 roles in AI safety, GenAI evaluation, and applied
        data science. If that&rsquo;s what you&rsquo;re hiring for, the fastest route
        is email — I reply within a day or two.
      </p>

      <p>{availability}</p>

      <ul class="border-border divide-border mt-8 flex flex-col divide-y border-y">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                {...(link.external
                  ? { target: "_blank", rel: "noopener noreferrer" }
                  : {})}
                {...(link.download ? { download: link.download } : {})}
              >
                <span>{link.label}</span>
                <span class="text-muted-foreground block font-mono text-xs">
                  {link.value}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <ContactForm client:load />
  </div>
</Base>
