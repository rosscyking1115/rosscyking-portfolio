# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# build output
dist/

# generated types
.astro/

# TRANSITIONAL — delete these two lines once the stale directories are gone.
# Cutover left `.next/` and `astro/` in the working tree as untracked build
# artefacts. Neither is in git, but without an ignore entry a `git add -A`
# stages ~15k files from .next/ by accident. Run `git clean -fdx .next astro`,
# then remove this block. Tracked in MIGRATION-PLAN §"Still open".
.next/
astro/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but keep the documented template. The bare `.env*` above matches at every
# depth, so this negation is what makes the example trackable. Carried over
# from astro/.gitignore at cutover.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# testing
coverage
playwright-report
test-results
playwright/.cache

# jetbrains
.idea/

# Internal PMO handoff docs — never publish
HANDOFF-*.md

# Design-pass captures. Regenerated by `npm run shots:site`; megabytes per pass,
# and last month's screenshots are of no use to anyone.
docs/design-pass/
