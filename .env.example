# Astro contact pipeline — copy to .env for local development.
#
# Every var is OPTIONAL. With none set, the form still works end to end:
# Turnstile verification is skipped, rate limiting is a no-op, and the
# submission is logged to the server console instead of emailed. That is the
# same graceful-degradation behaviour the Next app had.
#
# ⚠ PREFIX CHANGE: Astro exposes browser vars via PUBLIC_, not NEXT_PUBLIC_.
#    These need renaming in the Vercel dashboard before cutover.
#    https://docs.astro.build/en/guides/environment-variables/

# Public (browser-visible by design)
PUBLIC_SITE_URL=https://rosscyking.com

# ⚠ LEAVING THIS BLANK HIDES THE WIDGET COMPLETELY, AND THAT HAS COST A BUG.
#    With no key the Turnstile branch in ContactForm renders nothing, so the
#    contact form you develop and test against is not the one visitors get.
#    /contact shipped scrolling sideways at 320px and 360px for exactly this
#    reason: the widget's 300px min-width set the width of the whole page, and
#    130 passing tests never saw it because the widget was not there.
#
#    To see the real thing locally, use Cloudflare's published dummy site key —
#    visible widget, always passes, no account needed:
#      PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#    Others: 2x00000000000000000000AB always blocks, 3x00000000000000000000FF
#    forces an interactive challenge.
#    https://developers.cloudflare.com/turnstile/troubleshooting/testing/
#
#    Note the widget does not mount in headless Chromium on localhost, so this
#    makes it visible to a human, not to Playwright. The suite protects the
#    layout with a stand-in instead — see tests/e2e/responsive.spec.ts.
PUBLIC_TURNSTILE_SITE_KEY=

# Secrets (server only, never bundled)
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
RESEND_TO_EMAIL=
RESEND_FROM_EMAIL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
