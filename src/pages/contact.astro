---
import { ArrowUpRight, Download, Mail } from "@lucide/astro";

import { ContactForm } from "../components/ContactForm";
import BrandIcon from "../components/icons/BrandIcon.astro";
import Container from "../components/layout/Container.astro";
import IndexMark from "../components/layout/IndexMark.astro";
import SectionHead from "../components/layout/SectionHead.astro";
import Base from "../layouts/Base.astro";
import { siteConfig } from "../lib/site-config";

/**
 * The one route in the whole site that is NOT prerendered.
 *
 * Astro Actions called from a form require on-demand rendering, and on-demand
 * rendering requires an adapter — hence @astrojs/vercel in astro.config.mjs.
 * Everything else stays static.
 *   https://docs.astro.build/en/guides/actions/
 *   https://docs.astro.build/en/guides/on-demand-rendering/
 *
 * Built first, during risk #1, before the design system existed — so it shipped
 * with bare markup and a note that styling would arrive with the component
 * port. This is that: Container, IndexMark, the availability pill and the
 * icon-led contact list, all matching src/app/contact/page.tsx.
 */
export const prerender = false;

const strip = (url: string) => url.replace(/^https?:\/\/(www\.)?/, "");

const links = [
  { label: "Email", value: siteConfig.email, href: `mailto:${siteConfig.email}` },
  {
    label: "GitHub",
    value: strip(siteConfig.links.github),
    href: siteConfig.links.github,
    external: true,
    brand: "github" as const,
  },
  {
    label: "LinkedIn",
    value: strip(siteConfig.links.linkedin),
    href: siteConfig.links.linkedin,
    external: true,
    brand: "linkedin" as const,
  },
  {
    label: "Download CV",
    value: "PDF",
    href: "/cv.pdf",
    download: "Cheng-Yuan-King-CV.pdf",
  },
];
---

<Base
  title="Contact"
  description="Get in touch about applied AI, GenAI evaluation, data science, and AI safety roles in the UK. Replies usually within a couple of days."
  canonical="/contact"
>
  {
    /*
      THREE WIDTHS, NO OTHERS (execution audit, finding 04). The header sits at
      the reading measure inside the 1152 container, so the rules align to the
      content rather than to the frame.
    */
  }
  <Container class="pt-12 sm:pt-16" size="lg">
    <div class="max-w-[680px]">
      <IndexMark mark="Contact" label="Sheffield, UK · GMT" />
      <h1 class="font-display mt-4 text-4xl font-bold tracking-tight sm:text-5xl">
        Let&rsquo;s talk.
      </h1>
      <p class="text-body mt-4 text-lg leading-relaxed text-pretty">
        I&rsquo;m looking for 2026 roles in AI safety, GenAI evaluation, and applied data
        science. If that&rsquo;s what you&rsquo;re hiring for, the fastest route is email
        &mdash; I reply within a day or two.
      </p>
    </div>
  </Container>

  {
    /*
      THE ROUTE'S ONE BAND (R9, screen 16a): "one ruled line, a 6px #3f9a5f dot,
      'Available for full-time roles from October 2026'. The three-cell
      availability block is gone."

      THE VISA FACT IS NOT HERE, AND THAT OVERRULES THE SPEC. 16a asks for it
      right-aligned as a 12px mono label; Ross's call on 3 Aug 2026 is to remove
      every mention of visas and sponsorship from the site, and that the
      availability line alone is enough. It is his fact about his own right to
      work, so it is his to publish or not — the spec cannot want it more than
      he does. The line is the whole band now.

      AND ITS GOING CLOSES OPEN ITEM 06 BY DELETION, which is worth saying out
      loud rather than letting it disappear. That item asked Ross for two facts
      — what he is seeking, and his typical reply time — to fill two dashed
      cells in the three-cell block. There is no three-cell block now. "Seeking"
      is answered by the standfirst directly above, in his own words. The reply
      time is not gone: it moves to the receipt, where "by when" is what the
      person who just wrote to him actually needs, and it is still dashed there.
    */
  }
  <section
    aria-label="Availability"
    class="bg-muted border-border border-y"
    data-availability-band
  >
    <Container size="lg" class="py-6">
      <p class="text-base font-medium">
        <span
          class="bg-state-live mr-2.5 inline-block size-1.5 rounded-full align-middle"
          aria-hidden="true"></span>{siteConfig.availability}
      </p>
    </Container>
  </section>

  {
    /*
      THE SAME GRID AS THE WRITE-UP — 680 + 120 + 352 inside 1152 — and the same
      reason for the literals: they add up exactly, and a fractional rewrite
      would look identical in review while moving the primary column off the
      measure every other one on the site uses.

      THE FORM IS THE PRIMARY COLUMN (16a), which is a swap: it used to sit in
      the right-hand column behind the intro and the link list, so the page led
      with three ways not to use the thing it is for. Direct routes move to the
      rail and take no heading rung at all — the allocation table is explicit
      that they get none.
    */
  }
  <Container class="pb-16 sm:pb-20" size="lg">
    <div class="mt-10 xl:grid xl:grid-cols-[680px_352px] xl:gap-x-[120px]">
      {
        /*
          `min-w-0`. Grid items default to `min-width: auto`, so a column cannot
          shrink below its widest child's min-content — and one child, the
          Turnstile widget, carries a hard 300px floor. Stacked on a phone that
          floor used to set the width of the whole page and /contact scrolled
          sideways. The widget picks its own size now (see ContactForm), but
          this is the structural half: no single child decides the page's width.
        */
      }
      <div class="max-w-[680px] min-w-0">
        <SectionHead rung="major" mark="01" label="Send a message" class="mt-0" />
        <div class="mt-6">
          <ContactForm client:load />
        </div>
      </div>

      <aside aria-label="Direct routes" class="mt-12 min-w-0 xl:mt-0">
        <div class="xl:sticky xl:top-24">
          <p
            class="text-muted-foreground text-label font-mono tracking-[0.12em] uppercase"
          >
            Direct
          </p>
          <div class="border-border divide-border mt-3 flex flex-col divide-y border-y">
            {
              links.map((link) => (
                <a
                  href={link.href}
                  {...(link.external
                    ? { target: "_blank", rel: "noopener noreferrer" }
                    : {})}
                  {...(link.download ? { download: link.download } : {})}
                  class="group hover:text-primary ease-instrument flex items-center gap-3 py-3.5 transition-[color] duration-[var(--motion-state)]"
                >
                  <span class="border-border text-muted-foreground flex size-9 items-center justify-center rounded border">
                    {link.brand ? (
                      <BrandIcon name={link.brand} class="size-4" />
                    ) : link.label === "Email" ? (
                      <Mail class="size-4" aria-hidden="true" />
                    ) : (
                      <Download class="size-4" aria-hidden="true" />
                    )}
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block text-sm font-medium">{link.label}</span>
                    <span class="text-muted-foreground block truncate font-mono text-xs">
                      {link.value}
                    </span>
                  </span>
                  <ArrowUpRight
                    class="text-muted-foreground size-4 shrink-0"
                    aria-hidden="true"
                  />
                </a>
              ))
            }
          </div>
        </div>
      </aside>
    </div>
  </Container>
</Base>
