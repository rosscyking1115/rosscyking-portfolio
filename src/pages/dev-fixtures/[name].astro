---
import { ArrowRight } from "@lucide/astro";

import EvidenceFrame from "../../components/home/EvidenceFrame.astro";
import NowBuilding from "../../components/home/NowBuilding.astro";
import Container from "../../components/layout/Container.astro";
import IndexMark from "../../components/layout/IndexMark.astro";
import Badge from "../../components/ui/Badge.astro";
import Base from "../../layouts/Base.astro";
import { DEFAULT_LENS } from "../../lib/lenses";
import type { NowBuildingEntry } from "../../lib/now-building";
import {
  getLensFeaturedCards,
  projectReadingTime,
  type Project,
} from "../../lib/projects";

/**
 * Dev-only fixture routes, for components whose real data makes them render
 * nothing.
 *
 * WHY THIS EXISTS. The "Now building" strip is driven by an array that is
 * currently empty, so on the live page it renders nothing at all. That is
 * correct behaviour — and it is also precisely why the component was missing
 * from the Astro port for four phases without a single test failing. A
 * component that renders nothing is indistinguishable from a component that was
 * never written, so "the page looks right" proves nothing about it.
 *
 * WHY A ROUTE RATHER THAN A UNIT TEST. The app has no unit-test runner, only
 * Playwright against `astro dev`. Adding vitest (or driving Astro's Container
 * API from a bare node script) to render one component was more machinery than
 * a fixture page, and would test the component through a different pipeline
 * than the one that actually serves it.
 *
 * WHY IT CANNOT LEAK INTO PRODUCTION. `getStaticPaths` returns [] unless
 * import.meta.env.DEV, and a dynamic route with no paths generates no pages —
 * so `astro build` emits nothing here. tests/e2e/completeness.spec.ts asserts
 * the route is absent from the built output, so the guard is tested rather
 * than trusted.
 *
 * WHY NOT AN UNDERSCORE-PREFIXED DIRECTORY, which is Astro's own mechanism for
 * keeping tests and helpers inside src/pages: `_`-prefixed files "won't be
 * recognized by the router", full stop — including by the dev server. That
 * excludes it from the build and from Playwright alike, which is one exclusion
 * too many. https://docs.astro.build/en/guides/routing/#excluding-pages
 */
export function getStaticPaths() {
  if (!import.meta.env.DEV) return [];
  return [
    { params: { name: "now-building" } },
    { params: { name: "headlines" } },
    { params: { name: "featured-cards" } },
  ];
}

const FIXTURES: Record<string, readonly NowBuildingEntry[]> = {
  "now-building": [
    { name: "fixture-project-one", blurb: "A first line, for the fixture." },
    { name: "fixture-project-two", blurb: "A second line, for the stagger." },
  ],
};

/**
 * Hero headline candidates, set in the real hero typography.
 *
 * Copy decisions at display size cannot be made from a list in a pull request:
 * `text-6xl` with `tracking-tight` and `text-balance` changes where lines break,
 * how much ink a comma is worth, and whether a highlighted phrase lands. This
 * renders every candidate in the exact classes Hero.astro uses so the choice is
 * made by looking rather than by imagining.
 *
 * `lead` is the plain opening, `mark` is the phrase that takes text-primary.
 */
const HEADLINES: { id: string; lead: string; mark: string; note: string }[] = [
  {
    id: "current",
    lead: "I turn ambiguous data and AI problems into",
    mark: "measurable systems.",
    note: "Current. Leads with data — the thing the positioning moved away from.",
  },
  {
    id: "A",
    lead: "I build AI systems and",
    mark: "prove whether they work.",
    note: "Your first shape. Shortest.",
  },
  {
    id: "B",
    lead: "I build AI systems and prove,",
    mark: "honestly,",
    note: "Your second shape — highlight on the differentiating word. (…whether they work.)",
  },
  {
    id: "D",
    lead: "I build AI systems and",
    mark: "measure whether they work.",
    note: "A, with Hamel Husain's verb. 'Measure' is engineering; 'prove' is rhetoric.",
  },
  {
    id: "E",
    lead: "I work on",
    mark: "AI evaluation and reliability.",
    note: "Chip Huyen's shape. Names the field outright. Shortest and most confident.",
  },
  {
    id: "F",
    lead: "I build AI systems and the",
    mark: "evidence that they work.",
    note: "Ties to 'evidence you can trace back' already used on /about.",
  },
  {
    id: "G",
    lead: "I make AI systems measurable, and their",
    mark: "failures visible.",
    note: "Names the unglamorous half. Closest to what the projects actually do.",
  },
  {
    id: "H",
    lead: "I build release gates for AI systems, so you know",
    mark: "before it ships.",
    note: "Most specific to the actual work. Longest — check the line breaks.",
  },
];

/**
 * Featured-card layout comparison.
 *
 * Two candidate shapes for the featured showcase, rendered side by side with
 * the real projects at real widths, because a layout argument settles in ten
 * seconds of looking and never settles in prose.
 *
 *   A — one full-container card per project, frame always on the right.
 *   B — two-up inside one panel, header stacked above the frame (the shape
 *       zeon.studio uses for its agency showcase).
 *
 * Both carry `.reveal-on-scroll`, so scrolling shows the real entrance too.
 */
const featured: Project[] =
  ((await getLensFeaturedCards())[DEFAULT_LENS] as Project[] | undefined) ?? [];

const frameCaption = (project: Project): string => {
  const source = project.data.links?.demo ?? project.data.links?.report;
  return source ? new URL(source).hostname : "run log";
};

const { name } = Astro.params;
const entries = FIXTURES[name!] ?? [];
---

<Base
  title="Fixture"
  description="Dev-only component fixture. Not part of the built site."
  canonical="/404"
>
  {name === "now-building" && <NowBuilding entries={entries} />}

  {
    name === "headlines" && (
      <Container class="py-12">
        <p class="text-muted-foreground mb-10 font-mono text-xs tracking-wider uppercase">
          Hero headline candidates &middot; real type, real widths &middot; toggle the
          theme
        </p>
        <div class="flex flex-col gap-12">
          {HEADLINES.map((h) => (
            <div class="border-border border-t pt-6">
              <p class="text-muted-foreground mb-3 font-mono text-[11px]">
                [ {h.id} ] {h.note}
              </p>
              <div class="max-w-3xl">
                <h2 class="font-display text-4xl leading-[1.05] font-bold tracking-tight text-balance sm:text-5xl lg:text-6xl">
                  {h.lead} <span class="text-primary">{h.mark}</span>
                  {h.id === "B" && " whether they work."}
                </h2>
              </div>
            </div>
          ))}
        </div>
      </Container>
    )
  }

  {
    name === "featured-cards" && (
      <Container class="py-12">
        <p class="text-muted-foreground mb-2 font-mono text-xs tracking-wider uppercase">
          Featured card layouts &middot; real projects, real widths &middot; scroll to see
          the entrance
        </p>

        <div class="ruler mt-10 mb-6" aria-hidden="true" />
        <IndexMark mark="A" label="One card per project — frame always right" />
        <p class="text-muted-foreground mt-2 max-w-prose text-sm leading-relaxed">
          Every project gets the full container. The frame takes three of five columns, so
          it lands around 632px — larger than today's flagship, and double today's smaller
          cards. The metrics sit in the text column beside the evidence.
        </p>

        <div class="mt-8 flex flex-col gap-6">
          {featured.map((project, i) => (
            <article
              class="reveal-on-scroll linked-card group border-border bg-card hover:border-foreground/20 hover:shadow-lift relative grid gap-6 rounded-lg border p-6 shadow-xs transition-[transform,box-shadow,border-color] duration-150 hover:-translate-y-0.5 lg:grid-cols-5 lg:gap-8 lg:p-8"
              style={`--reveal-shift: ${i * 4}%`}
            >
              <div class="flex min-w-0 flex-col lg:col-span-2">
                <div class="text-muted-foreground flex items-center justify-between font-mono text-xs">
                  <span class="text-primary">{String(i + 1).padStart(2, "0")}</span>
                  <span>
                    {project.data.period} · {projectReadingTime(project)}
                  </span>
                </div>
                <h3 class="font-display mt-4 text-2xl font-semibold tracking-tight text-balance">
                  {project.data.title}
                </h3>
                <p class="text-muted-foreground mt-3 line-clamp-4 text-sm leading-relaxed">
                  {project.data.summary}
                </p>
                {project.data.metrics && project.data.metrics.length > 0 && (
                  <dl class="mt-5 flex flex-wrap gap-x-6 gap-y-2">
                    {project.data.metrics.map((metric) => (
                      <div>
                        <dt class="sr-only">{metric.label}</dt>
                        <dd class="font-mono text-sm">
                          <span class="text-foreground font-semibold">
                            {metric.value}
                          </span>{" "}
                          <span class="text-muted-foreground text-xs">
                            {metric.label}
                          </span>
                        </dd>
                      </div>
                    ))}
                  </dl>
                )}
                <div class="mt-5 flex flex-wrap items-center gap-1.5">
                  {project.data.stack.slice(0, 4).map((tech) => (
                    <Badge variant="tag">{tech}</Badge>
                  ))}
                </div>
                <span class="text-primary mt-auto inline-flex items-center gap-1.5 pt-5 text-sm font-medium">
                  Read the write-up
                  <ArrowRight class="size-3.5" aria-hidden="true" />
                </span>
              </div>
              <div class="order-first min-w-0 lg:order-none lg:col-span-3">
                <EvidenceFrame
                  caption={frameCaption(project)}
                  live={Boolean(project.data.links?.demo)}
                  screenshot={project.data.screenshot}
                  alt={`Screenshot of the ${project.data.title} live demo`}
                  lines={project.data.terminal}
                  sizes="(min-width: 1024px) 55vw, (min-width: 640px) 90vw, 100vw"
                />
              </div>
            </article>
          ))}
        </div>

        <div class="ruler mt-20 mb-6" aria-hidden="true" />
        <IndexMark mark="B" label="Two up in one panel — header above the frame" />
        <p class="text-muted-foreground mt-2 max-w-prose text-sm leading-relaxed">
          The zeon.studio shape, in this site's language. Frames land around 600px. Note
          what happens to the numbers: with the header stacked above the image there is no
          column for them, so they either crowd the header or drop out. Note also the odd
          cell — three projects in a two-up grid.
        </p>

        <div class="border-border bg-muted/30 mt-8 rounded-lg border p-5">
          <div class="grid gap-6 lg:grid-cols-2">
            {featured.map((project, i) => (
              <article
                class="reveal-on-scroll linked-card group border-border bg-card hover:border-foreground/20 hover:shadow-lift relative flex min-w-0 flex-col rounded-lg border p-5 shadow-xs transition-[transform,box-shadow,border-color] duration-150 hover:-translate-y-0.5"
                style={`--reveal-shift: ${i * 4}%`}
              >
                <div class="text-muted-foreground flex items-center justify-between font-mono text-xs">
                  <span class="text-primary">{String(i + 1).padStart(2, "0")}</span>
                  <span>
                    {project.data.period} · {projectReadingTime(project)}
                  </span>
                </div>
                <h3 class="font-display mt-3 text-xl font-semibold tracking-tight text-balance">
                  {project.data.title}
                </h3>
                {project.data.metrics && project.data.metrics.length > 0 && (
                  <dl class="mt-3 flex flex-wrap gap-x-5 gap-y-1">
                    {project.data.metrics.map((metric) => (
                      <div>
                        <dt class="sr-only">{metric.label}</dt>
                        <dd class="font-mono text-sm">
                          <span class="text-foreground font-semibold">
                            {metric.value}
                          </span>{" "}
                          <span class="text-muted-foreground text-xs">
                            {metric.label}
                          </span>
                        </dd>
                      </div>
                    ))}
                  </dl>
                )}
                <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
                  <div class="flex flex-wrap items-center gap-1.5">
                    {project.data.stack.slice(0, 3).map((tech) => (
                      <Badge variant="tag">{tech}</Badge>
                    ))}
                  </div>
                  <span class="text-primary inline-flex shrink-0 items-center gap-1.5 text-sm font-medium">
                    Read
                    <ArrowRight class="size-3.5" aria-hidden="true" />
                  </span>
                </div>
                <div class="mt-4 min-w-0">
                  <EvidenceFrame
                    caption={frameCaption(project)}
                    live={Boolean(project.data.links?.demo)}
                    screenshot={project.data.screenshot}
                    alt={`Screenshot of the ${project.data.title} live demo`}
                    lines={project.data.terminal}
                    sizes="(min-width: 1024px) 45vw, 90vw"
                  />
                </div>
              </article>
            ))}
          </div>
        </div>
      </Container>
    )
  }
</Base>
