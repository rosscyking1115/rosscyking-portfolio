---
import { Content as Bio } from "../../content/about.mdx";

import CredentialList from "../components/about/CredentialList.astro";
import ExperienceTimeline from "../components/about/ExperienceTimeline.astro";
import Container from "../components/layout/Container.astro";
import IndexMark from "../components/layout/IndexMark.astro";
import Base from "../layouts/Base.astro";
import { certifications, virtualTraining } from "../lib/certifications";
import { education, languages } from "../lib/experience";
import { siteConfig } from "../lib/site-config";
import { skillGroups } from "../lib/skills";

/**
 * Ported from src/app/about/page.tsx.
 *
 * The bio is imported straight from content/about.mdx at the repo root. It has
 * no front matter and there is exactly one of it, so a content collection would
 * be ceremony — a direct MDX import gives the same rendering (and the same
 * single source) with less machinery. The Next app read it with fs + a
 * hand-rolled cache; both disappear.
 *
 * The Toolbox aside now owns the skills list outright: SkillsCluster was cut
 * from the home page so the site stops saying the same thing twice (Ross's
 * Phase 0 call, 2026-07-27).
 */

// Languages live in their own sidebar block, so drop that group from the toolbox.
const toolboxGroups = skillGroups.filter((group) => group.label !== "Languages");
---

<Base
  title="About"
  description="MSc Artificial Intelligence at the University of Sheffield. I build data and ML systems you can audit: tested pipelines, honest evaluation, and evidence you can trace back to where it came from."
  canonical="/about"
>
  <Container class="py-12 sm:py-16">
    <div class="grid gap-12 lg:grid-cols-[1fr_18rem]">
      {/* Bio + education */}
      <div class="max-w-prose">
        <IndexMark mark="About" label={siteConfig.name} />
        <h1
          class="font-display mt-4 text-4xl font-bold tracking-tight text-balance sm:text-5xl"
        >
          I build data and ML systems you can audit.
        </h1>

        <div
          class="text-muted-foreground [&_a]:text-primary [&_strong]:text-foreground mt-6 text-lg leading-relaxed [&_a]:underline [&_a]:underline-offset-2 [&_strong]:font-semibold [&>p+p]:mt-4"
          data-bio
        >
          <Bio />
        </div>

        <div class="ruler my-12" aria-hidden="true"></div>

        <IndexMark mark="01" label="Education" />
        <ExperienceTimeline items={education} />

        <div class="ruler my-12" aria-hidden="true"></div>

        <IndexMark mark="02" label="Certifications" />
        <CredentialList items={certifications} />

        <div class="ruler my-12" aria-hidden="true"></div>

        <IndexMark mark="03" label="Virtual training" />
        <CredentialList items={virtualTraining} />
      </div>

      {/* Toolbox + languages */}
      <aside class="lg:sticky lg:top-24 lg:self-start">
        <div class="border-border rounded-lg border p-6">
          <IndexMark mark="04" label="Toolbox" />
          <div class="mt-5 space-y-5" data-toolbox>
            {
              toolboxGroups.map((group) => (
                <div>
                  <div class="text-primary font-mono text-[11px] tracking-wider uppercase">
                    {group.label}
                  </div>
                  <div class="mt-2 flex flex-wrap gap-1.5">
                    {group.items.map((item) => (
                      <span class="border-border bg-background rounded border px-2 py-0.5 text-xs">
                        {item}
                      </span>
                    ))}
                  </div>
                </div>
              ))
            }
          </div>

          <div class="bg-border my-6 h-px w-full"></div>

          <IndexMark mark="05" label="Languages" />
          <ul class="mt-4 space-y-2.5 text-sm" data-languages>
            {
              languages.map((language) => (
                <li class="flex items-center justify-between gap-3">
                  <span>{language.name}</span>
                  <span class="text-muted-foreground font-mono text-xs">
                    {language.level}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </Container>
</Base>
