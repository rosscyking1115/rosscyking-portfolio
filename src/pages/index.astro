---
import ArrivalScript from "../components/home/ArrivalScript.astro";
import FeaturedProjects from "../components/home/FeaturedProjects.astro";
import Hero from "../components/home/Hero.astro";
import ProofBand from "../components/home/ProofBand.astro";
import Base from "../layouts/Base.astro";
import { getAllProjects } from "../lib/projects";
import { siteConfig } from "../lib/site-config";

/**
 * Home page. Ported from src/app/page.tsx + src/components/home/home-view.tsx.
 *
 * SkillsCluster is deliberately absent: it rendered the same `skillGroups` as
 * the Toolbox aside on /about, so the site said the same thing twice. Ross's
 * call (2026-07-27) was to show it once, on /about — home shows the stack
 * through the project cards' own chips instead. Recorded in MIGRATION-PLAN §2.
 */
const all = await getAllProjects();
---

<Base
  title={siteConfig.titleTagline}
  description={siteConfig.metaDescription}
  canonical="/"
  titleForm="default"
>
  {
    /*
      FIRST, AND THAT IS THE ONLY THING THAT MATTERS ABOUT ITS POSITION. It
      writes `data-motion` on <html>, which is what the ARRIVAL rules in
      global.css key off — so it has to have run before the browser paints the
      masthead it hides. Below <Hero /> and the headline appears complete, then
      drops to zero opacity to animate in.
    */
  }
  <ArrivalScript />
  <Hero />
  <ProofBand />
  <FeaturedProjects allCount={all.length} />
</Base>
