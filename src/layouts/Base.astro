---
import Analytics from "@vercel/analytics/astro";
import { Font } from "astro:assets";
import SpeedInsights from "@vercel/speed-insights/astro";

import LensScript from "../components/LensScript.astro";
import Footer from "../components/layout/Footer.astro";
import Nav from "../components/layout/Nav.astro";
import ThemeScript from "../components/ThemeScript.astro";
import { personSchema, websiteSchema } from "../lib/json-ld";
import { DEFAULT_OG_ALT, DEFAULT_OG_IMAGE, OG_SIZE } from "../lib/og-config";
import { siteConfig } from "../lib/site-config";
import "../styles/global.css";

/**
 * The site shell.
 *
 * Order inside <head> is load-bearing, not stylistic:
 *   1. ThemeScript and LensScript are inline and come FIRST, so the theme class
 *      and lens attribute are on <html> before the browser has any CSS to paint
 *      with. Move them below the stylesheet and you get a flash of the wrong
 *      theme — see risks #5 and #6.
 *   2. <Font /> emits the preload links and @font-face rules for Astro's Fonts
 *      API. Self-hosted from _astro/fonts, so the CSP needs no font CDN origin.
 *
 * Still to arrive with the page port: JSON-LD, sitemap, robots, manifest, icons.
 */
interface Props {
  title: string;
  description: string;
  /** Path-only canonical, e.g. "/contact". */
  canonical: string;
  /**
   * Path to the page's OG card. Defaults to the site-wide one; project pages
   * pass their own `/projects/<slug>/opengraph-image.png`.
   */
  ogImage?: string;
  /** Alt text for that card. Project pages pass PROJECT_OG_ALT. */
  ogImageAlt?: string;
  /**
   * Which way round the brand and the page name go.
   *
   * Ports Next's `metadata.title` split, which this layout originally
   * flattened into one form and got backwards for the home page:
   *
   *   template — "<page> — Ross King". Every route except home.
   *   default  — "Ross King — <tagline>". Home only, matching
   *              `metadata.title.default` in src/app/layout.tsx.
   *
   * The comment on site-config.ts documented the `default` form all along; the
   * code contradicted it, so / shipped as "<tagline> — Ross King" with the
   * brand last in <title>, og:title and twitter:title alike.
   */
  titleForm?: "template" | "default";
}

const {
  title,
  description,
  canonical,
  ogImage = DEFAULT_OG_IMAGE,
  ogImageAlt = DEFAULT_OG_ALT,
  titleForm = "template",
} = Astro.props;

const canonicalUrl = new URL(canonical, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
const fullTitle =
  titleForm === "default"
    ? `${siteConfig.shortName} — ${title}`
    : `${title} — ${siteConfig.shortName}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Must precede the stylesheet — see the note above. */}
    <ThemeScript />
    <LensScript />

    <Font cssVariable="--font-geist-sans" preload />
    <Font cssVariable="--font-geist-mono" />
    <Font cssVariable="--font-space-grotesk" preload />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    {
      /* Ported from the Next root layout. Astro serves these at stable paths, so
        unlike Next's hash-suffixed URLs they can also be listed in the manifest. */
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon.png" type="image/png" sizes="512x512" />
    <link
      rel="apple-touch-icon"
      href="/apple-icon.png"
      type="image/png"
      sizes="180x180"
    />
    <link rel="manifest" href="/manifest.webmanifest" />

    {/* Open Graph — mirrors the tag set the Next app emits today. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.shortName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(OG_SIZE.width)} />
    <meta property="og:image:height" content={String(OG_SIZE.height)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en_GB" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:type" content="image/png" />
    <meta name="twitter:image:width" content={String(OG_SIZE.width)} />
    <meta name="twitter:image:height" content={String(OG_SIZE.height)} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {
      /*
      Person + WebSite structured data, ported from src/lib/json-ld.ts. The Next
      app had to work around React 19 refusing <script> inside a client
      component; an .astro file has no such constraint, so this is just a script
      tag. set:html avoids Astro escaping the JSON.
    */
    }
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(personSchema())}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(websiteSchema())}
    />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a href="#main" class="skip-to-content">Skip to content</a>
    <Nav />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />

    {
      /*
      Vercel Web Analytics and Speed Insights, restored at cutover.

      These were rendered by the Next root layout and were missing from the
      Astro port entirely — not in package.json, not in any component. Nothing
      would have failed: the site builds, deploys and serves fine, the numbers
      just stop arriving. Found by diffing the Next layout against this one
      rather than by anything going red.

      The adapter's `webAnalytics: { enabled: true }` option is NOT the right
      mechanism here. Per the adapter docs it applies to @vercel/analytics
      1.3.x and earlier; from 1.4.0 the component is the supported route, and
      the installed version is 2.0.1.
        https://docs.astro.build/en/guides/integrations-guide/vercel/#webanalytics
    */
    }
    <Analytics />
    <SpeedInsights />
  </body>
</html>
