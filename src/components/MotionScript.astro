---
/**
 * The site's one motion system.
 *
 * Replaces the CSS `.reveal` / `.reveal-on-scroll` / `.reveal-focus` classes
 * outright. Ross's call (2026-08-01), taken with the costs in front of him:
 * GSAP gives the same bidirectional focus effect in EVERY browser, where the
 * CSS scroll-timeline version only worked where `animation-timeline` is
 * supported and degraded to a one-shot elsewhere. That reverses the Part 2
 * brief's "do not add an animation library", deliberately.
 *
 * The motion-performance skill is explicit that mixing two animation systems is
 * a critical-priority mistake, so there is exactly one here and the CSS classes
 * are gone.
 *
 * ── What this owns, and what it deliberately does not ────────────────────────
 *
 * GSAP owns `[data-motion="focus"]`: the scroll-linked, scrubbed, bidirectional
 * card reveal, everywhere it appears.
 *
 * It does NOT own the hero. That animates through `.rise` in global.css,
 * transform-only, so the headline paints immediately and nothing above the fold
 * waits on this file. Putting the hero on GSAP was tried and measured, and the
 * numbers are in the comment on the loader below.
 *
 * ── Nothing is hidden by CSS, on purpose ─────────────────────────────────────
 *
 * The initial hidden state for `focus` elements is set by GSAP itself, at init.
 * If the script never runs — network failure, JS disabled, an error in a
 * dependency — nothing ever hid the content, so the page renders complete and
 * static. That is the whole failure mode handled, without an inline pre-paint
 * class or a release timeout. It is safe to do this way precisely BECAUSE every
 * `focus` element is below the fold: there is no window in which a visitor sees
 * them un-hidden and then watches them disappear.
 */
---

<script>
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  /**
   * GSAP is imported DYNAMICALLY, and that is the whole point of this file's
   * shape. Measured on a Vercel preview with GSAP on the critical path:
   *
   *     mobile (4x CPU)   99 -> 96,  LCP 1,808ms -> 2,588ms
   *     desktop          100 -> 100, LCP   413ms ->   584ms
   *
   * The profile attributed 959ms of bootup to this chunk — GSAP's parse and
   * execute, not its download. Desktop never noticed, but 2,588ms crosses
   * Google's 2.5s "good" LCP threshold, and this site gets opened from phones.
   *
   * So nothing here runs during initial load. The hero animates in CSS (`.rise`
   * in global.css, transform-only), and GSAP is fetched once the main thread is
   * idle after `load`, or on the first scroll — whichever comes first. Every
   * element it touches is below the fold, so waiting costs nothing.
   *
   * There is no flash to guard against, and the reason is worth stating because
   * it is not obvious: ScrollTrigger's `scrub` derives progress from POSITION,
   * so an element already on screen when GSAP initialises computes to a high
   * opacity immediately. It can never be handed a visible element and hide it.
   */
  function whenIdle(run: () => void) {
    let started = false;
    const start = () => {
      if (started) return;
      started = true;
      run();
    };

    // First scroll wins if the visitor is quicker than the idle callback.
    window.addEventListener("scroll", start, { once: true, passive: true });

    const schedule = () => {
      // Read off a widened reference: `"x" in window` narrows `window` to
      // `never` in the else branch, so `window.setTimeout` stops type-checking.
      const idle = (
        window as Window & {
          requestIdleCallback?: (cb: () => void, opts?: { timeout: number }) => number;
        }
      ).requestIdleCallback;
      if (idle) idle(start, { timeout: 2500 });
      else setTimeout(start, 1200);
    };

    if (document.readyState === "complete") schedule();
    else window.addEventListener("load", schedule, { once: true });
  }

  /**
   * Reduced motion is handled by never loading GSAP at all — stronger than
   * shortening durations, and it also spares those visitors the download. No
   * element is ever hidden, so there is nothing to animate out of.
   *
   * The CSS version had a bug of exactly this shape: it reset
   * `animation-duration` but never `animation-delay`, and `fill-mode: both`
   * held elements at opacity 0 through the delay, so a visitor who asked for
   * less motion still got the staggered pop-in with instant tweens.
   */
  async function init() {
    const targets = document.querySelectorAll<HTMLElement>('[data-motion="focus"]');
    if (targets.length === 0) return;

    const [{ gsap }, { ScrollTrigger }] = await Promise.all([
      import("gsap"),
      import("gsap/ScrollTrigger"),
    ]);
    gsap.registerPlugin(ScrollTrigger);

    for (const el of targets) {
      gsap
        .timeline({
          scrollTrigger: {
            trigger: el,
            start: "top bottom",
            end: "bottom top",
            scrub: true,
          },
        })
        // Proportions, not seconds — under `scrub` the timeline is mapped onto
        // the element's pass through the viewport, so these are shares of that
        // distance. The 1 : 2.6 : 1 split keeps a card fully opaque for the
        // middle ~57% of its travel, which is the whole time it is readable.
        // Shorten the hold and you are fading text someone is reading, which is
        // a contrast problem rather than a taste one.
        .fromTo(
          el,
          { opacity: 0, y: 32 },
          { opacity: 1, y: 0, duration: 1, ease: "none" },
        )
        .to(el, { opacity: 1, y: 0, duration: 2.6, ease: "none" })
        .to(el, { opacity: 0, y: -32, duration: 1, ease: "none" });
    }

    // Screenshots settle after first paint and change every trigger's geometry.
    window.addEventListener("load", () => ScrollTrigger.refresh());

    // Switching lens swaps which panel is display:none, so every measurement
    // taken while it was hidden is wrong. FeaturedProjects dispatches this.
    document.addEventListener("lens:change", () => ScrollTrigger.refresh());
  }

  if (!reduceMotion.matches) whenIdle(init);
</script>
