---
import { ArrowRight } from "@lucide/astro";

import {
  projectHeadline,
  projectMarkLabel,
  projectReadingTime,
  projectState,
  type Project,
} from "../../lib/projects";
import ContentState from "./ContentState.astro";
import MetricMode from "./MetricMode.astro";
import MetricReadout from "./MetricReadout.astro";

/**
 * The row anatomy itself — mono mark, title, value column, one action at the
 * end (§03 R4).
 *
 * ── WHY IT IS SPLIT OUT OF InstrumentRow ─────────────────────────────────────
 * Because there are now two things that can wrap it: a stretched link, or a
 * <summary> that opens a preview. R4's rule is "a fifth list pattern is a bug",
 * and the fastest way to grow one is to copy this markup into the second branch
 * and let the two drift. There is one copy, and the branch above it chooses the
 * wrapper — so a change to the value column lands on both surfaces or neither.
 *
 * The layout is identical in both modes down to the trailing glyph's cell,
 * which is 32px wide in both — an arrow is 16px and needs the room round it
 * anyway, and a bracketed [+] at 12px mono measures 29px. The first cut sized
 * that cell to the arrow and rendered a bare "−", which is four pixels of grey
 * line at the far right of a 1088px row: technically present, and not an
 * affordance anyone would find.
 */
interface Props {
  project: Project;
  /**
   * `link` gives the title a stretched anchor over the whole row. `disclosure`
   * gives it no link at all — the row is a <summary> and the link out lives in
   * the panel it opens.
   */
  mode: "link" | "disclosure";
}

const { project, mode } = Astro.props;

const headline = projectHeadline(project);
const state = projectState(project.id);
const mark = projectMarkLabel(project.id);

/** Three stacks, then the reading time — the row's mono meta line. */
const meta = [...project.data.stack.slice(0, 3), projectReadingTime(project)].join(" · ");
---

{
  /*
    44px minimum and the WHOLE ROW is the target, not the arrow (§05 TOUCH).
    In link mode the stretched anchor gives the row one hit area and one
    accessible name; in disclosure mode the <summary> already is one.

    `items-start` rather than centre: the title wraps to two lines at narrow
    widths and the mark should stay level with its first line.
  */
}
<div class="flex min-h-11 flex-col gap-3 p-4 sm:flex-row sm:items-start sm:gap-5">
  {
    /*
      `data-catalogue` is the hook the canonical-mark tests read on all three
      surfaces (home, index, write-up), so they can compare the same project's
      number across them. Keep it: without it those tests can still find A
      mark, which is exactly the weakness that let the mark contradict itself
      for as long as it did.

      aria-hidden because the mark is repeated as "Project 01:" inside the
      link below, where it belongs to the accessible name.
    */
  }
  <span
    class="text-primary shrink-0 font-mono text-xs tabular-nums sm:pt-1"
    data-catalogue
    aria-hidden={mode === "link" ? "true" : undefined}>{mark}</span
  >

  <div class="min-w-0 flex-1">
    <h3
      class="font-display ease-instrument text-base font-semibold tracking-tight text-[color:var(--instrument-title)] transition-[color] duration-[var(--motion-address)]"
    >
      {
        mode === "link" ? (
          <a
            href={`/projects/${project.id}`}
            class="after:absolute after:inset-0 after:rounded-lg"
          >
            <span class="sr-only">Project {mark}: </span>
            {project.data.title}
          </a>
        ) : (
          project.data.title
        )
      }
    </h3>
    <p class="text-muted-foreground mt-1 font-mono text-xs">{meta}</p>
  </div>

  {
    /*
      FIXED WIDTHS, because this is a column and not a right-hand margin.
      The first cut let both cells size to their content, so ten values landed
      at ten different x positions — 41.4M, 7,264, 0.24 0.42, 0–4% — and the
      one page built for comparing projects made the eye travel to find each
      number. A comparison surface needs a ruled column even when there is no
      <table>. The widths are MEASURED, not guessed, and both have been
      measured twice.

      The readout is 14rem because the longest label, "holdout precision
      (corrected)", renders at 209px in Geist Mono 12px; 13rem is 208px, so it
      wrapped and left two of the ten rows 96px tall against everyone else's
      81px.

      The token column was 11rem and is now 13rem. The status tokens became
      the spec's pills — 99px radius, 12px, 12px of horizontal padding each
      side — and the widest pair, CONTROLLED (104px) beside RUN LOG (81px),
      needs 193px against the 176px it had. Two rows wrapped and grew to 92px.
      Measured across all ten: the largest requirement is 193px, so 13rem
      (208px) clears every pair with room for a longer token than any that
      exists.

      Below sm the two stack rather than sharing a wrapped flex line. Wrapped,
      the chips landed BETWEEN a value and its own label — so "41.4M" and
      "journeys unified" were split by two pills, which reads as three
      unrelated facts instead of one measurement.
    */
  }
  <div class="flex shrink-0 flex-col gap-2 sm:flex-row sm:items-start sm:gap-4">
    <MetricReadout headline={headline} class="sm:w-56" />
    <div class="flex flex-wrap items-center gap-2 sm:w-[13rem] sm:pt-0.5">
      {headline && <MetricMode mode={headline.mode} />}
      <ContentState state={state} />
    </div>
  </div>

  {
    /*
      One action at the end (R4). Static in both modes — the motion contract
      bans the nudge, and it bans the rotation a chevron would need, which is
      why the disclosure marker is a mono [+] / [−] swapped on [open] rather
      than one glyph turning over. It is also the site's own index-mark
      language, so the affordance reads as part of the system instead of as a
      widget borrowed from one.
    */
  }
  {
    mode === "link" ? (
      <ArrowRight
        class="text-muted-foreground hidden size-4 shrink-0 self-center sm:block"
        aria-hidden="true"
      />
    ) : (
      <span
        class="text-primary hidden w-8 shrink-0 self-center text-center font-mono text-xs sm:block"
        data-disclosure-marker
        aria-hidden="true"
      />
    )
  }
</div>
