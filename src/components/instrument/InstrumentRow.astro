---
import { projectState, type Project } from "../../lib/projects";
import { cn } from "../../lib/utils";
import InstrumentPreview from "./InstrumentPreview.astro";
import InstrumentRowBody from "./InstrumentRowBody.astro";

/**
 * THE INSTRUMENT — step 03 of the design spec's build order, and the one row
 * anatomy the whole site is built from (§03 R4): mono label, value, one action
 * at the end. The spec is blunt about what happens if this is not shared —
 * "a fifth list pattern is a bug" — so this component is used by the projects
 * index, the home ledger, the write-up's cross-references and the about page's
 * record rack rather than each one growing its own row.
 *
 * The anatomy itself lives in InstrumentRowBody.astro, because there are now
 * two wrappers that can carry it. This file owns the addressing and the choice
 * of wrapper; that one owns the row.
 *
 * ── ADDRESSING (§02) ─────────────────────────────────────────────────────────
 * A row is either RECEDED or READING, and the difference is colour, border and
 * surface. Two things about that are load-bearing:
 *
 *   1. NEVER HEIGHT. The spec calls this a hard requirement and names the
 *      consequence: implement receding as a height change and the page shifts
 *      under the reader's thumb on every scroll, and CLS eats the Lighthouse
 *      score the whole system exists to protect. Every state below changes
 *      `border-color` and `background-color` only. The border is always
 *      present, at the same width, so even the resting state reserves it.
 *
 *      A DISCLOSURE IS NOT AN EXCEPTION TO THIS, and the distinction is the
 *      one the amended motion contract turns on. Addressing happens TO the
 *      reader as they scroll, so it must never move the page under them.
 *      Opening a row happens BECAUSE of the reader, on a row they are pointing
 *      at, in response to a click they made. The layout shift is the answer to
 *      the question, not an interruption of it.
 *
 *   2. A RECEDED ROW IS TWO LEVELS, NOT ONE. The title recedes to
 *      --muted-foreground; the metric stays at --foreground. §02 spells out
 *      why: "a plain metric is foreground exactly like a corrected one.
 *      Corrections are distinguished by the struck pair and the accent pill,
 *      never by being the only legible number."
 *
 * The third addressing input, proximity to the reading line, is implemented in
 * global.css and is scoped to devices with no pointer — see the note there.
 */
interface Props {
  project: Project;
  /**
   * The reading instrument. Exactly one row in a list should carry this, and
   * §03 R7 is the reason it is a prop rather than a state: only the reading
   * instrument loads an image, so the list has to decide, not the row.
   */
  reading?: boolean;
  /**
   * `link` — the whole row is a stretched anchor to the write-up. The right
   * behaviour on /projects, where the page's job is to compare and move on.
   *
   * `disclosure` — the row opens a short preview in place. Ross's call for the
   * home bench (2 Aug 2026): "below project should all be able to toggle open a
   * drop down, show a simple version of the feature card, and all interactive."
   *
   * The two cannot be combined, and the attempt is worth recording because it
   * was the first cut: a stretched link over a <summary> swallows the toggle,
   * so the row opens and then immediately navigates away from itself. One of
   * them has to own the click. In disclosure mode the row owns it and the link
   * out moves into the panel.
   */
  mode?: "link" | "disclosure";
  class?: string;
}

const { project, reading = false, mode = "link", class: className } = Astro.props;
const state = projectState(project.id);
---

<article
  data-instrument
  data-state={state}
  data-reading={reading ? "" : undefined}
  class={cn(
    // `.instrument` in global.css owns every addressing state — the reading
    // list marking it, a pointer, and keyboard focus all resolve to one rule
    // there. Repeating it as Tailwind variants here would put three copies of
    // the same intent on every consumer, which is how the four entrance
    // animations this codebase used to carry came about.
    "instrument group relative rounded-lg",
    mode === "link" && "linked-card",
    className,
  )}
>
  {
    mode === "disclosure" ? (
      <details data-disclosure>
        {/*
          `list-none` and `block` on the summary, because a summary is
          `display: list-item` by default and the marker box would otherwise
          indent the mark column out of line with every other row on the page.
          The webkit marker and `list-style` are both cleared in global.css.

          `reticle-cursor` here rather than on the <article>: the panel below
          holds a link and body text, and a reticle over a paragraph you are
          trying to select is the kind of flourish that makes a page feel worse
          the second time you use it.
        */}
        <summary class="reticle-cursor block rounded-lg">
          <InstrumentRowBody project={project} mode="disclosure" />
        </summary>
        <InstrumentPreview project={project} />
      </details>
    ) : (
      <InstrumentRowBody project={project} mode="link" />
    )
  }
</article>
