---
import type { ContentState } from "../../lib/projects";
import { cn } from "../../lib/utils";

/**
 * One of the three content states (§03 R6), as the spec's status pill.
 *
 *   LIVE      1px #e2e3e7 border, 5px dot #3f9a5f (#66b587 dark)
 *   RUN LOG   1px SOLID #e2e3e7 border, text #5c6068
 *   ARCHIVED  1px DASHED #cdd0d6 border, text #5c6068
 *
 * Built the first time as 4px-radius rectangles from the mock alone; the spec
 * README — which arrived later and is authoritative — gives pills at 99px and
 * names a different border colour for ARCHIVED. The dashed border is the only
 * dashed border on the site apart from an unfilled data slot, which is what
 * makes it read as "this one stopped" rather than as decoration.
 *
 * SIZE: 12px, not the spec's 10px. See the conflict note in global.css.
 *
 * The state is never a prop anyone chooses by hand — it comes from
 * `projectState()`, derived from registry fields the validator already gates.
 * Finding 06 of the audit was that this vocabulary did not exist at all: one
 * archived project rendered identically to nine live ones.
 */
interface Props {
  state: ContentState;
  class?: string;
}

const { state, class: className } = Astro.props;

const STYLES: Record<ContentState, string> = {
  LIVE: "border-border",
  "RUN LOG": "border-border",
  // #cdd0d6 — the reading border, not the hairline. A dashed hairline is
  // almost invisible; the spec picks the darker of the two on purpose.
  ARCHIVED: "border-instrument-reading-border border-dashed",
};
---

<span
  class={cn(
    "text-muted-foreground rounded-pill inline-flex items-center gap-1.5 border px-3 py-0.5 font-mono text-label tracking-wider whitespace-nowrap uppercase",
    STYLES[state],
    className,
  )}
>
  {
    state === "LIVE" && (
      /* 5px, per the spec. Larger than the 6px dot used elsewhere on the site
         would be, because inside a pill it competes with the cap height. */
      <span class="bg-state-live size-[5px] shrink-0 rounded-full" aria-hidden="true" />
    )
  }
  {state}
</span>
