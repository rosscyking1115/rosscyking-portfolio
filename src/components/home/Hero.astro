---
import { ArrowRight, Download } from "@lucide/astro";

import { siteConfig } from "../../lib/site-config";
import BrandIcon from "../icons/BrandIcon.astro";
import Container from "../layout/Container.astro";
import IndexMark from "../layout/IndexMark.astro";
import Button from "../ui/Button.astro";

/**
 * The masthead (design spec §04, home route).
 *
 *   "Masthead loses two blocks. Role chips demote to one mono line and the
 *    proof panel leaves the hero entirely. Six stacked blocks become four, so
 *    the H1 gets the room to be the only large thing here."
 *
 * Both blocks are gone:
 *
 *   1. THE PROOF PANEL. It sat in a right-hand rail at lg, which is where audit
 *      finding 05 found it — "your three best numbers sit in the hero's right
 *      column at roughly a third the size of the headline". It is now the
 *      full-bleed band immediately below (ProofBand.astro), where the change of
 *      measure does what a bigger font size could not.
 *   2. THE ROLE CHIPS. Three bordered pills behind a "Roles →" caption became
 *      one mono line. Nothing was cut — the same three strings, in the same
 *      order, at a weight that no longer competes with the headline.
 *
 * WHICH MEANS THE TWO-COLUMN GRID GOES TOO, and with it the measurement that
 * justified it. The container is 1152px; the hero column was capped at 768px,
 * left aligned, leaving 384px of empty right-hand column on every desktop — and
 * the readout was moved in to fill it. With the readout gone the honest fix is
 * a single column at a reading measure rather than a rail with nothing in it.
 *
 * THE STANDFIRST IS ROSS'S, UNCUT. The spec's mock shortens it to two
 * sentences, and "copy is selected, never rewritten" would permit that — but
 * this string is also `siteConfig.description`, which Ross authored
 * deliberately in an earlier pass. Trimming published copy is his call, not a
 * layout decision, so it is left whole and flagged instead.
 */
/**
 * Order is the message, not an alphabetisation.
 *
 * These read left to right and a scanner stops at the first one, so the lead
 * role is doing the same job as the <title>. It used to read "Data Engineering
 * · ML Engineering · AI Safety & Evaluation", which put the thing Ross moved
 * away from first and the thing he moved to last — the metadata said one thing
 * and the two largest signals on the page said another.
 */
const ROLES = [
  "AI Evaluation & Reliability",
  "ML Engineering",
  "Data Engineering",
] as const;
---

<Container class="pt-16 pb-14 sm:pt-24 sm:pb-16">
  <div class="max-w-3xl">
    {
      /*
        The availability signal folds into the mark line rather than sitting in
        its own pill above it — one block instead of two, and the dot is the
        LIVE token the instrument uses, held still (the motion contract bans
        continuous animation).
      */
    }
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
      <IndexMark mark={siteConfig.shortName} label="Sheffield, UK" />
      <span
        class="text-muted-foreground inline-flex items-center gap-2 font-mono text-xs"
      >
        <span class="bg-state-live inline-flex size-1.5 rounded-full" aria-hidden="true"
        ></span>
        {siteConfig.availability}
      </span>
    </div>

    <h1
      class="font-display mt-6 text-4xl leading-[1.05] font-bold tracking-tight text-balance sm:text-5xl lg:text-6xl"
    >
      I work on <span class="text-primary">AI evaluation and reliability.</span>
    </h1>

    <p class="text-body mt-6 max-w-prose text-lg leading-relaxed text-pretty">
      {siteConfig.description}
    </p>

    <p class="text-muted-foreground mt-6 font-mono text-xs tracking-wide">
      {ROLES.join(" · ")}
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <Button href="/projects">
        View projects
        <ArrowRight aria-hidden="true" />
      </Button>
      <Button href="/cv.pdf" variant="outline" download="Cheng-Yuan-King-CV.pdf">
        <Download aria-hidden="true" />
        Download CV
      </Button>
      <Button
        href={siteConfig.links.github}
        variant="ghost"
        target="_blank"
        rel="noopener noreferrer"
      >
        <BrandIcon name="github" class="size-4" />
        GitHub
      </Button>
      <Button
        href={siteConfig.links.linkedin}
        variant="ghost"
        target="_blank"
        rel="noopener noreferrer"
      >
        <BrandIcon name="linkedin" class="size-4" />
        LinkedIn
      </Button>
    </div>
  </div>
</Container>
