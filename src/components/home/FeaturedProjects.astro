---
import { ArrowRight } from "@lucide/astro";

import { allLenses, DEFAULT_LENS } from "../../lib/lenses";
import {
  getAllProjects,
  getLensFeaturedCards,
  projectHeadline,
  projectMarkLabel,
  projectReadingTime,
  type Project,
} from "../../lib/projects";
import NarrowingControl from "../controls/NarrowingControl.astro";
import InstrumentRow from "../instrument/InstrumentRow.astro";
import MetricReadout from "../instrument/MetricReadout.astro";
import Container from "../layout/Container.astro";
import IndexMark from "../layout/IndexMark.astro";
import Badge from "../ui/Badge.astro";
import EvidenceFrame from "./EvidenceFrame.astro";
import NowBuilding from "./NowBuilding.astro";

/**
 * The rack and the ledger (design spec §04, home route), as amended by Ross on
 * 2 August 2026.
 *
 * ── WHAT CHANGED, AND WHAT IT OVERRULES ──────────────────────────────────────
 * §03 R7 read: "One instrument reads, siblings are hairline rows… Only the
 * reading instrument loads an image." Ross's call is that every featured
 * project is open, the first one takes the most space, and each arrives as you
 * reach it. R7 is therefore no longer in force ON THIS SECTION — it still is
 * everywhere else, which is why the bench below is rows and why /projects is
 * untouched.
 *
 * It is worth being precise about what that costs, because R7 was not
 * arbitrary. It bought two things:
 *
 *   1. IMAGES. The rack was one screenshot per lens; it is now one per featured
 *      project — three for `all` and `data`, four for `ai`. Only the lead card
 *      of the DEFAULT lens is eager; every other frame is lazy and sits either
 *      below the fold or inside a display:none lens panel, so the request count
 *      on first paint is unchanged at one. The bytes that ship regardless are
 *      the markup.
 *   2. FLATNESS. Audit finding 08 was "eleven blocks arrive at the same width
 *      off the same margin with roughly the same tonal weight". Three identical
 *      cards would walk straight back into it — which is exactly why the lead
 *      card is a different SHAPE and not merely a bigger one: five columns
 *      against two, a taller frame, and the only summary paragraph in the rack.
 *      The rhythm now comes from the difference between the cards rather than
 *      from the difference between a card and a row.
 *
 * ── THE ARRIVAL ──────────────────────────────────────────────────────────────
 * Each card carries `data-enter="scroll"`, which holds it at 14px and zero
 * opacity until an IntersectionObserver marks it once — see ArrivalScript.astro
 * and the ARRIVAL block in global.css. There is no stagger between them and
 * there should not be: they are far enough apart that the reader triggers each
 * one by scrolling, so the page itself is the stagger.
 *
 * SWITCHING LENS IS NOT AN ARRIVAL, and this is the trap the old entrance fell
 * into three times. A hidden lens panel is `display: none`, so its cards have
 * never been observed; when a panel is shown they arrive once, and switching
 * back finds them already marked. The `:not([data-shown])` in the CSS and the
 * `unobserve` in the script are both doing that work. A filter is not a
 * navigation and the showcase must not flash on a click.
 *
 * ── THE LEDGER, WHICH NOW OPENS ──────────────────────────────────────────────
 *   "The rest is a table, not more cards. This is what stops the showcase and
 *    the index doing the same job twice: home shows work running, this shows
 *    the ledger, the index compares."
 *
 * Still true, and the disclosure is what keeps it true now that the rack is
 * three cards rather than one. A bench row is a line in a ledger until you ask
 * it a question; the answer is a short preview, not a fourth card. See
 * InstrumentPreview.astro for why it is not the rack card at a smaller size.
 *
 * Each lens still gets its own prerendered panel with CSS choosing the visible
 * one off `data-lens`, so the whole section ships as static HTML with no
 * hydration.
 */
interface Props {
  allCount: number;
}

const { allCount } = Astro.props;
const lensCards = await getLensFeaturedCards();
const all = await getAllProjects();

/** Mono caption for the frame title bar: the visual's host, or a run label. */
function frameCaption(project: Project): string {
  const source = project.data.links?.demo ?? project.data.links?.report;
  if (source) return new URL(source).hostname;
  return "run log";
}

const COUNT_WORDS = ["No", "One", "Two", "Three", "Four", "Five", "Six", "Seven"];
/** "Four" for 4, falling back to the digit for anything past the list. */
const countWord = (n: number) => COUNT_WORDS[n] ?? String(n);

const allLabel = `All ${allCount} projects`;
---

<Container class="pt-14 pb-20 sm:pt-16">
  <NarrowingControl
    name="lens"
    label="Viewing as"
    groupLabel="View this portfolio by role"
    options={allLenses.map((lens) => ({ value: lens.key, label: lens.label }))}
    defaultValue={DEFAULT_LENS}
    class="border-border/70 mb-10 border-b border-dashed pb-6"
  />

  {
    allLenses.map((lens) => {
      const featured = lensCards[lens.key] ?? [];
      const featuredIds = new Set(featured.map((project) => project.id));
      const bench = all.filter((project) => !featuredIds.has(project.id));

      return (
        <div data-lens-panel={lens.key}>
          <div class="flex items-end justify-between gap-6">
            <div>
              <IndexMark mark="01" label="Featured work" />
              <h2
                class="font-display mt-3 text-3xl font-semibold tracking-tight text-balance"
                data-lens-headline
              >
                {countWord(featured.length)} projects, shown working
              </h2>
            </div>
            <a
              href="/projects"
              class="text-muted-foreground hover:text-foreground ease-instrument hidden shrink-0 items-center gap-1.5 py-1 text-sm font-medium transition-colors duration-[var(--motion-state)] sm:inline-flex"
            >
              {allLabel}
              <ArrowRight class="size-4" aria-hidden="true" />
            </a>
          </div>

          {/*
            `data-rack` bounds the featured set. Without it "count the
            <article>s in this panel" means something different than it used to
            — every InstrumentRow is an <article> too, so the bench is inside
            the same panel and the count is the whole portfolio. The hook exists
            because the test that broke was asserting the right thing about the
            wrong scope.
          */}
          <div data-rack>
            {featured.map((project, index) => {
              const lead = index === 0;
              const headline = projectHeadline(project);

              return (
                <article
                  class:list={[
                    // `lg:items-center` is not a nicety. The text column is
                    // always shorter than a 16:10 frame, and the lead card's
                    // 68vh minimum makes the difference larger still — first
                    // cut, the action sat 250px below the stack chips with
                    // nothing in between, which reads as a card that failed to
                    // load rather than one with room to breathe. Centred, the
                    // spare height becomes symmetric padding.
                    "instrument linked-card reticle-cursor group relative grid rounded-lg lg:items-center",
                    // THE LEAD CARD IS A DIFFERENT SHAPE, not a bigger one —
                    // see finding 08 in the note at the top. Five columns to
                    // two, and the only summary paragraph in the rack.
                    //
                    // `lg:min-h-[68vh]` is what makes "scrolling to the first
                    // project shows only the first project" true on a desktop.
                    // It is a MINIMUM and it is scoped to lg: pinning a card to
                    // the viewport on a phone is how you get content that
                    // cannot be scrolled past, and the frame already makes the
                    // card tall there.
                    lead
                      ? "mt-6 gap-6 p-6 lg:min-h-[68vh] lg:grid-cols-5 lg:gap-10 lg:p-8"
                      : "mt-8 gap-5 p-5 sm:mt-12 sm:p-6 lg:grid-cols-2 lg:gap-8",
                  ]}
                  data-reading
                  data-enter="scroll"
                  data-rack-card={index}
                >
                  <div class:list={["flex min-w-0 flex-col", lead && "lg:col-span-2"]}>
                    <div class="text-muted-foreground flex items-center justify-between font-mono text-xs">
                      <span class="text-primary" data-catalogue>
                        {projectMarkLabel(project.id)}
                      </span>
                      <span>
                        {project.data.period} · {projectReadingTime(project)}
                      </span>
                    </div>
                    <h3
                      class:list={[
                        "font-display mt-4 font-semibold tracking-tight text-balance",
                        lead ? "text-2xl" : "text-xl",
                      ]}
                    >
                      <a
                        href={`/projects/${project.id}`}
                        class="after:absolute after:inset-0 after:rounded-lg"
                      >
                        {project.data.title}
                      </a>
                    </h3>

                    {/*
                      §03 R2 — no summary paragraph on two index surfaces. The
                      lead card is the one place on this page that carries
                      prose; the other cards state their number and their stack
                      and stop, which is also what keeps them a different shape
                      rather than a smaller copy.
                    */}
                    {lead && (
                      <p class="text-body mt-3 line-clamp-4 text-sm leading-relaxed">
                        {project.data.summary}
                      </p>
                    )}

                    {/*
                      The headline number in the card's own voice, at `lead`
                      size on the lead card — the same MetricReadout the log
                      renders, including the struck pair when the number is a
                      correction. The old three-metric strip listed everything
                      the project publishes; this shows the ONE number the
                      project turns on.
                    */}
                    <MetricReadout
                      headline={headline}
                      size={lead ? "lead" : undefined}
                      class="mt-5"
                    />

                    <div class="mt-5 flex flex-wrap items-center gap-1.5">
                      {project.data.stack.slice(0, 4).map((tech) => (
                        <Badge variant="tag">{tech}</Badge>
                      ))}
                    </div>
                    <span
                      class="text-primary inline-flex items-center gap-1.5 pt-5 text-sm font-medium"
                      data-card-action
                    >
                      Read the write-up
                      <ArrowRight class="size-3.5" aria-hidden="true" />
                    </span>
                  </div>

                  {/*
                    `order-first` below lg. Stacked, the source order put the
                    evidence frame AFTER "Read the write-up" — so on a phone the
                    screenshot arrived below the card's own call to action,
                    while every other row on the page leads with its number. At
                    lg the frame sits right of the text, where DOM order is
                    already right.

                    EAGER ON EXACTLY ONE FRAME IN THE DOCUMENT: the lead card of
                    the default lens. Everything else is lazy and is either
                    below the fold or inside a display:none panel, so the first
                    paint still fetches one image however many are in the
                    markup.
                  */}
                  <div
                    class:list={[
                      "order-first min-w-0 lg:order-none",
                      lead && "lg:col-span-3",
                    ]}
                  >
                    <EvidenceFrame
                      caption={frameCaption(project)}
                      live={Boolean(project.data.links?.demo)}
                      screenshot={project.data.screenshot}
                      alt={`Screenshot of the ${project.data.title} live demo`}
                      lines={project.data.terminal}
                      sizes={
                        lead
                          ? "(min-width: 1024px) 55vw, (min-width: 640px) 90vw, 100vw"
                          : "(min-width: 1024px) 45vw, (min-width: 640px) 90vw, 100vw"
                      }
                      eager={lead && lens.key === DEFAULT_LENS}
                    />
                  </div>
                </article>
              );
            })}
          </div>

          {bench.length > 0 && (
            <div class="mt-14" data-bench>
              <IndexMark mark="02" label="The rest of the bench" />
              <p class="text-body mt-3 max-w-prose text-sm leading-relaxed">
                Not featured under this lens — the same rows, the same numbers. Open one
                for the short version.
                <a
                  href="/projects"
                  class="text-primary ml-1 font-medium underline-offset-2 hover:underline"
                >
                  Compare all {allCount} on the index &rarr;
                </a>
              </p>
              <ul class="mt-5 flex flex-col gap-2">
                {bench.map((project) => (
                  <li>
                    <InstrumentRow project={project} mode="disclosure" />
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      );
    })
  }

  <NowBuilding />
</Container>

<style>
  /*
    THE ENTRANCE IS BACK, AND THE HISTORY IS WHY IT LOOKS NOTHING LIKE THE ONE
    THAT WAS REMOVED. See the ARRIVAL block in src/styles/global.css.

    This showcase carried the old reveal's whole history: a scoped keyframe,
    then a shared `.reveal`, then `.reveal-on-scroll`. Each step fixed a real
    problem the previous one had, and the lens switcher exposed the one that
    could not be fixed from inside a reveal at all — a hidden lens panel is
    display:none, so its animation had never run, and switching lens REPLAYED
    the entrance for every card. The `view()` timeline worked around it by
    putting an on-screen card at the end of its own range.

    The replacement does not need the workaround, because the thing that made
    it necessary is gone: state now lives in an attribute the observer sets
    once, not in an animation's position on a timeline. A card that has arrived
    stays arrived — through a lens switch, through scrolling back up, through
    anything short of a reload. That is the difference between "animate when
    visible" and "arrive once", and only the second one is safe to put on a
    filtered list.
  */

  /* Only the panel matching <html data-lens> is shown. Hidden by default so
     nothing flashes before the narrowing script runs. */
  [data-lens-panel] {
    display: none;
  }
  :global(html[data-lens="all"]) [data-lens-panel="all"],
  :global(html[data-lens="ai"]) [data-lens-panel="ai"],
  :global(html[data-lens="data"]) [data-lens-panel="data"] {
    display: block;
  }
</style>
