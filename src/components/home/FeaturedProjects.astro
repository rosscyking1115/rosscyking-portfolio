---
import { ArrowRight } from "@lucide/astro";

import { allLenses, DEFAULT_LENS } from "../../lib/lenses";
import {
  getLensFeaturedCards,
  projectReadingTime,
  type Project,
} from "../../lib/projects";
import Container from "../layout/Container.astro";
import IndexMark from "../layout/IndexMark.astro";
import Badge from "../ui/Badge.astro";
import EvidenceFrame from "./EvidenceFrame.astro";
import NowBuilding from "./NowBuilding.astro";

/**
 * Featured showcase with an in-place role-lens switcher.
 *
 * Ported from src/components/home/featured-projects.tsx. The Next version was a
 * client component holding every lens's cards in React state; here each lens
 * gets its own prerendered panel and CSS shows the matching one, driven by the
 * `data-lens` attribute LensScript sets before first paint (risk #6).
 *
 * That means the whole showcase — flagship card, evidence frames, stack chips,
 * metrics — ships as static HTML with no hydration.
 */
interface Props {
  allCount: number;
}

const { allCount } = Astro.props;
const lensCards = await getLensFeaturedCards();

/** Mono caption for the frame title bar: the visual's host, or a run label. */
function frameCaption(project: Project): string {
  const source = project.data.links?.demo ?? project.data.links?.report;
  if (source) return new URL(source).hostname;
  return "run log";
}

const COUNT_WORDS = ["No", "One", "Two", "Three", "Four", "Five", "Six", "Seven"];
/** "Four" for 4, falling back to the digit for anything past the list. */
const countWord = (n: number) => COUNT_WORDS[n] ?? String(n);

const allLabel = `All ${allCount} projects`;
---

<Container class="pb-20">
  <div class="border-border/70 mb-8 border-b border-dashed pb-6">
    {
      /*
      Ported from src/components/home/lens-switcher.tsx. The first cut of this
      component was written from scratch rather than from that file and drifted
      on three counts: it dropped the "Viewing as →" caption, set the buttons in
      the sans face instead of mono, and inverted the active treatment to a
      solid primary fill. Next tints the active pill to 10% and keeps the label
      in primary — restored here.

      The active state is driven by `aria-pressed` rather than a React prop, so
      the styling hangs off the aria-pressed: variant and the attribute stays
      the single source of truth for both look and assistive tech.
    */
    }
    <div
      role="group"
      aria-label="View this portfolio by role"
      class="flex flex-wrap items-center gap-x-3 gap-y-2"
    >
      <span class="text-muted-foreground font-mono text-xs tracking-wider uppercase">
        Viewing as&nbsp;→
      </span>
      <div class="flex flex-wrap gap-1.5">
        {
          allLenses.map((lens) => (
            <button
              type="button"
              data-lens-button={lens.key}
              aria-pressed={lens.key === DEFAULT_LENS ? "true" : "false"}
              class="focus-visible:ring-ring border-border text-muted-foreground hover:border-foreground/30 hover:text-foreground aria-pressed:border-primary aria-pressed:bg-primary/10 aria-pressed:text-primary cursor-pointer rounded-full border px-3 py-1 font-mono text-xs whitespace-nowrap transition-colors focus-visible:ring-2 focus-visible:outline-none aria-pressed:font-medium"
            >
              {lens.label}
            </button>
          ))
        }
      </div>
    </div>
  </div>

  {
    allLenses.map((lens) => {
      const projects = lensCards[lens.key] ?? [];

      const count = projects.length;
      const lastNumber = String(count).padStart(2, "0");

      return (
        <div data-lens-panel={lens.key}>
          <div class="flex items-end justify-between gap-6">
            <div>
              <IndexMark mark="01" label="Featured work" />
              <h2
                class="font-display mt-3 text-3xl font-semibold tracking-tight text-balance"
                data-lens-headline
              >
                {countWord(count)} projects, shown working
              </h2>
              <p class="text-muted-foreground mt-2 max-w-prose text-sm leading-relaxed">
                {`Numbered 01–${lastNumber} by what I’d want you to read first — not by date. The screenshots are the actual apps; every card links to the evidence.`}
              </p>
            </div>
            <a
              href="/projects"
              class="text-muted-foreground hover:text-foreground hidden shrink-0 items-center gap-1.5 py-1 text-sm font-medium sm:inline-flex"
            >
              {allLabel}
              <ArrowRight class="size-4" aria-hidden="true" />
            </a>
          </div>

          {/*
            ONE CARD SHAPE, repeated. This was a flagship card plus a two- or
            three-up grid, and the split had stopped earning itself.

            The grid rendered its evidence frames at 308px on every desktop
            width — measured — against 598px for the flagship. These screenshots
            are dense dashboards with 11px labels, so at 308px they were
            decorative images, which is exactly what EvidenceFrame's own comment
            says they must never be, under a heading promising "shown working".
            The layout was also built for four featured projects; with three,
            sizing card 01 above the rest only repeated what the 01 / 02 / 03
            registration marks already say.

            Every card now takes the full container and gives the frame three of
            five columns — about 600px at the 1152px cap, so the SMALLEST frame
            here is larger than the old flagship's. Same side every time: the
            marks carry the sequence, so alternating sides would be decoration.

            No `hover:-translate-y` on these, deliberately — see the note on
            MotionScript. GSAP owns the transform on these cards, so a hover
            translate would be fought over by two systems; they keep the shadow
            and border-colour hover instead.
          */}
          <div class="mt-8 flex flex-col gap-6">
            {projects.map((project, i) => (
              <article
                data-motion="focus"
                class="linked-card group border-border bg-card hover:border-foreground/20 hover:shadow-lift relative grid gap-6 rounded-lg border p-6 shadow-xs transition-[box-shadow,border-color] duration-200 lg:grid-cols-5 lg:gap-8 lg:p-8"
              >
                <div class="flex min-w-0 flex-col lg:col-span-2">
                  <div class="text-muted-foreground flex items-center justify-between font-mono text-xs">
                    <span class="text-primary">{String(i + 1).padStart(2, "0")}</span>
                    <span>
                      {project.data.period} · {projectReadingTime(project)}
                    </span>
                  </div>
                  <h3 class="font-display mt-4 text-2xl font-semibold tracking-tight text-balance">
                    <a
                      href={`/projects/${project.id}`}
                      class="after:absolute after:inset-0 after:rounded-lg"
                    >
                      {project.data.title}
                    </a>
                  </h3>
                  <p class="text-muted-foreground mt-3 line-clamp-4 text-sm leading-relaxed">
                    {project.data.summary}
                  </p>
                  {project.data.metrics && project.data.metrics.length > 0 && (
                    <dl class="mt-5 flex flex-wrap gap-x-6 gap-y-2">
                      {project.data.metrics.map((metric) => (
                        <div>
                          <dt class="sr-only">{metric.label}</dt>
                          <dd class="font-mono text-sm">
                            <span class="text-foreground font-semibold">
                              {metric.value}
                            </span>{" "}
                            <span class="text-muted-foreground text-xs">
                              {metric.label}
                            </span>
                          </dd>
                        </div>
                      ))}
                    </dl>
                  )}
                  <div class="mt-5 flex flex-wrap items-center gap-1.5">
                    {project.data.stack.slice(0, 4).map((tech) => (
                      <Badge variant="tag">{tech}</Badge>
                    ))}
                  </div>
                  <span class="text-primary mt-auto inline-flex items-center gap-1.5 pt-5 text-sm font-medium">
                    Read the write-up
                    <ArrowRight
                      class="size-3.5 transition-transform group-hover:translate-x-0.5"
                      aria-hidden="true"
                    />
                  </span>
                </div>
                {/*
                  `order-first` below lg. Stacked, the source order put the
                  evidence frame AFTER "Read the write-up", so on a phone the
                  screenshot arrived below the card's own call to action. At lg
                  the source order is restored and the frame returns to the right.
                */}
                <div class="order-first min-w-0 lg:order-none lg:col-span-3">
                  <EvidenceFrame
                    caption={frameCaption(project)}
                    live={Boolean(project.data.links?.demo)}
                    screenshot={project.data.screenshot}
                    alt={`Screenshot of the ${project.data.title} live demo`}
                    lines={project.data.terminal}
                    sizes="(min-width: 1024px) 55vw, (min-width: 640px) 90vw, 100vw"
                    eager={lens.key === DEFAULT_LENS && i === 0}
                  />
                </div>
              </article>
            ))}
          </div>
        </div>
      );
    })
  }

  <a
    href="/projects"
    class="text-muted-foreground hover:text-foreground mt-6 inline-flex items-center gap-1.5 py-1 text-sm font-medium sm:hidden"
  >
    {allLabel}
    <ArrowRight class="size-4" aria-hidden="true" />
  </a>

  <NowBuilding />
</Container>

<style>
  /*
    Motion for these cards lives in src/components/MotionScript.astro, not
    here and not in CSS. They carry `data-motion="focus"`, and GSAP scrubs a
    rise / hold / recede timeline across each card's pass through the viewport,
    so a card resolves as you reach it and recedes as it leaves — reversibly,
    because progress is tied to scroll position rather than to time.

    The Next component wrapped the flagship card, each grid card and the
    Now-building aside in <FadeIn>. When `motion` was swapped for CSS, Hero and
    /projects got that treatment and this file was missed, so the whole showcase
    landed with no entrance at all. That is the finding completeness.spec.ts
    guards.

    A hidden lens panel is display:none, so every ScrollTrigger measured while
    it was hidden is wrong. `select()` below dispatches `lens:change` and
    MotionScript refreshes on it.
  */

  /* Only the panel matching <html data-lens> is shown. Hidden by default so
     nothing flashes before LensScript runs. */
  [data-lens-panel] {
    display: none;
  }
  :global(html[data-lens="all"]) [data-lens-panel="all"],
  :global(html[data-lens="data"]) [data-lens-panel="data"],
  :global(html[data-lens="ai"]) [data-lens-panel="ai"] {
    display: block;
  }
</style>

<script>
  import { DEFAULT_LENS, isLensKey, lensHref, type LensKey } from "../../lib/lenses";

  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-lens-button]");

  function select(lens: LensKey, pushUrl: boolean) {
    document.documentElement.dataset.lens = lens;
    for (const button of buttons) {
      button.setAttribute("aria-pressed", String(button.dataset.lensButton === lens));
    }
    // Panels swap display, so ScrollTrigger's cached geometry is now stale.
    document.dispatchEvent(new CustomEvent("lens:change"));

    if (pushUrl) {
      // replaceState, not pushState: switching lens is a filter, not a
      // navigation. Back should leave the page, as it did in the Next app.
      window.history.replaceState({}, "", lensHref(lens));
    }
  }

  // The inline head script already resolved the lens (including retired-name
  // aliases); adopt it rather than re-parsing the URL and risking a mismatch.
  const initial = document.documentElement.dataset.lens ?? DEFAULT_LENS;
  select(isLensKey(initial) ? initial : DEFAULT_LENS, false);

  for (const button of buttons) {
    button.addEventListener("click", () => {
      const key = button.dataset.lensButton;
      if (key && isLensKey(key)) select(key, true);
    });
  }
</script>
