---
import { ArrowRight } from "@lucide/astro";

import { allLenses, DEFAULT_LENS } from "../../lib/lenses";
import {
  getLensFeaturedCards,
  projectMarkLabel,
  projectReadingTime,
  type Project,
} from "../../lib/projects";
import NarrowingControl from "../controls/NarrowingControl.astro";
import Container from "../layout/Container.astro";
import IndexMark from "../layout/IndexMark.astro";
import Badge from "../ui/Badge.astro";
import EvidenceFrame from "./EvidenceFrame.astro";
import NowBuilding from "./NowBuilding.astro";

/**
 * Featured showcase with an in-place role-lens switcher.
 *
 * Ported from src/components/home/featured-projects.tsx. The Next version was a
 * client component holding every lens's cards in React state; here each lens
 * gets its own prerendered panel and CSS shows the matching one, driven by the
 * `data-lens` attribute LensScript sets before first paint (risk #6).
 *
 * That means the whole showcase — flagship card, evidence frames, stack chips,
 * metrics — ships as static HTML with no hydration.
 */
interface Props {
  allCount: number;
}

const { allCount } = Astro.props;
const lensCards = await getLensFeaturedCards();

/** Mono caption for the frame title bar: the visual's host, or a run label. */
function frameCaption(project: Project): string {
  const source = project.data.links?.demo ?? project.data.links?.report;
  if (source) return new URL(source).hostname;
  return "run log";
}

const COUNT_WORDS = ["No", "One", "Two", "Three", "Four", "Five", "Six", "Seven"];
/** "Four" for 4, falling back to the digit for anything past the list. */
const countWord = (n: number) => COUNT_WORDS[n] ?? String(n);

const allLabel = `All ${allCount} projects`;
---

<Container class="pb-20">
  <div class="border-border/70 mb-8 border-b border-dashed pb-6">
    {
      /*
      THE LENS IS NOW THE SHARED NARROWING CONTROL (spec §03 R3), the same
      component the projects index uses for its stack filter and its sort.

      What was here before was the first of the site's two narrowing mechanics:
      buttons with `aria-pressed`, a click handler, and a `replaceState` call,
      all written out inline. The index had the second — a strip of <a> links
      that navigated. Two controls that looked alike and behaved differently.

      Everything that made this one right is preserved, because it was the
      better of the two: mono chips rather than sans, the active pill tinted to
      10% with the label in primary rather than a solid fill, `aria-pressed` as
      the single source of truth for both look and assistive tech, and the
      "Viewing as →" caption that the first port dropped.
    */
    }
    <NarrowingControl
      name="lens"
      label="Viewing as"
      groupLabel="View this portfolio by role"
      options={allLenses.map((lens) => ({ value: lens.key, label: lens.label }))}
      defaultValue={DEFAULT_LENS}
    />
  </div>

  {
    allLenses.map((lens) => {
      const projects = lensCards[lens.key] ?? [];
      const [flagship, ...rest] = projects;
      const count = projects.length;
      const lastNumber = String(count).padStart(2, "0");

      return (
        <div data-lens-panel={lens.key}>
          <div class="flex items-end justify-between gap-6">
            <div>
              <IndexMark mark="01" label="Featured work" />
              <h2
                class="font-display mt-3 text-3xl font-semibold tracking-tight text-balance"
                data-lens-headline
              >
                {countWord(count)} projects, shown working
              </h2>
              <p class="text-muted-foreground mt-2 max-w-prose text-sm leading-relaxed">
                {`Numbered 01–${lastNumber} by what I’d want you to read first — not by date. The screenshots are the actual apps; every card links to the evidence.`}
              </p>
            </div>
            <a
              href="/projects"
              class="text-muted-foreground hover:text-foreground hidden shrink-0 items-center gap-1.5 py-1 text-sm font-medium sm:inline-flex"
            >
              {allLabel}
              <ArrowRight class="size-4" aria-hidden="true" />
            </a>
          </div>

          {flagship && (
            <article class="linked-card group border-border bg-card hover:border-instrument-reading-border ease-instrument relative mt-8 grid gap-6 rounded-lg border p-6 shadow-xs transition-[border-color] duration-[var(--motion-address)] lg:grid-cols-5 lg:gap-8 lg:p-8">
              <div class="flex min-w-0 flex-col lg:col-span-2">
                <div class="text-muted-foreground flex items-center justify-between font-mono text-xs">
                  <span class="text-primary">{projectMarkLabel(flagship.id)}</span>
                  <span>
                    {flagship.data.period} · {projectReadingTime(flagship)}
                  </span>
                </div>
                <h3 class="font-display mt-4 text-2xl font-semibold tracking-tight text-balance">
                  <a
                    href={`/projects/${flagship.id}`}
                    class="after:absolute after:inset-0 after:rounded-lg"
                  >
                    {flagship.data.title}
                  </a>
                </h3>
                <p class="text-muted-foreground mt-3 line-clamp-4 text-sm leading-relaxed">
                  {flagship.data.summary}
                </p>
                {flagship.data.metrics && flagship.data.metrics.length > 0 && (
                  <dl class="mt-5 flex flex-wrap gap-x-6 gap-y-2">
                    {flagship.data.metrics.map((metric) => (
                      <div>
                        <dt class="sr-only">{metric.label}</dt>
                        <dd class="font-mono text-sm">
                          <span class="text-foreground font-semibold">
                            {metric.value}
                          </span>{" "}
                          <span class="text-muted-foreground text-xs">
                            {metric.label}
                          </span>
                        </dd>
                      </div>
                    ))}
                  </dl>
                )}
                <div class="mt-5 flex flex-wrap items-center gap-1.5">
                  {flagship.data.stack.slice(0, 4).map((tech) => (
                    <Badge variant="tag">{tech}</Badge>
                  ))}
                </div>
                <span class="text-primary mt-auto inline-flex items-center gap-1.5 pt-5 text-sm font-medium">
                  Read the write-up
                  <ArrowRight class="size-3.5" aria-hidden="true" />
                </span>
              </div>
              {/*
                `order-first` below lg. Stacked, the source order put the
                evidence frame AFTER "Read the write-up" — so on a phone the
                screenshot arrived below the card's own call to action, while
                every other card on the page leads with its frame. At lg the
                source order is restored and the frame returns to the right.
              */}
              <div class="order-first min-w-0 lg:order-none lg:col-span-3">
                <EvidenceFrame
                  caption={frameCaption(flagship)}
                  live={Boolean(flagship.data.links?.demo)}
                  screenshot={flagship.data.screenshot}
                  alt={`Screenshot of the ${flagship.data.title} live demo`}
                  lines={flagship.data.terminal}
                  sizes="(min-width: 1024px) 55vw, (min-width: 640px) 90vw, 100vw"
                  eager={lens.key === DEFAULT_LENS}
                />
              </div>
            </article>
          )}

          <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {rest.map((project) => (
              <article class="linked-card group border-border bg-card hover:border-instrument-reading-border ease-instrument relative flex h-full min-w-0 flex-col rounded-lg border p-5 shadow-xs transition-[border-color] duration-[var(--motion-address)]">
                <EvidenceFrame
                  caption={frameCaption(project)}
                  live={Boolean(project.data.links?.demo)}
                  screenshot={project.data.screenshot}
                  alt={`Screenshot of the ${project.data.title} live demo`}
                  lines={project.data.terminal}
                  sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw"
                />
                <div class="text-muted-foreground mt-4 flex items-center justify-between font-mono text-xs">
                  <span class="text-primary">{projectMarkLabel(project.id)}</span>
                  <span>
                    {project.data.period} · {projectReadingTime(project)}
                  </span>
                </div>
                <h3 class="font-display mt-2 text-lg font-semibold tracking-tight">
                  <a
                    href={`/projects/${project.id}`}
                    class="after:absolute after:inset-0 after:rounded-lg"
                  >
                    {project.data.title}
                  </a>
                </h3>
                <p class="text-muted-foreground mt-2 line-clamp-3 flex-1 text-sm leading-relaxed">
                  {project.data.summary}
                </p>
                <div class="mt-4 flex flex-wrap items-center gap-1.5">
                  {project.data.stack.slice(0, 3).map((tech) => (
                    <Badge variant="tag">{tech}</Badge>
                  ))}
                </div>
              </article>
            ))}
          </div>
        </div>
      );
    })
  }

  <a
    href="/projects"
    class="text-muted-foreground hover:text-foreground mt-6 inline-flex items-center gap-1.5 py-1 text-sm font-medium sm:hidden"
  >
    {allLabel}
    <ArrowRight class="size-4" aria-hidden="true" />
  </a>

  <NowBuilding />
</Container>

<style>
  /*
    THE ENTRANCE IS GONE, and the lens switcher is the clearest argument for
    why. See the MOTION CONTRACT in src/styles/global.css.

    This showcase carried the reveal's whole history: a scoped keyframe, then
    a shared `.reveal`, then `.reveal-on-scroll`. Each step fixed a real
    problem the previous one had, and the switcher exposed the one that could
    not be fixed from inside a reveal at all — a hidden lens panel is
    display:none, so its animation had never run, and switching lens REPLAYED
    the entrance for every card. The view() timeline worked around it by
    putting an on-screen card at the end of its own range.

    A filter is not a navigation, and the showcase should not flash on a click.
    With no entrance there is nothing to replay, nothing to work around, and no
    difference at all between a lens panel that was always visible and one
    revealed by a button. The workaround and the problem left together.
  */

  /* Only the panel matching <html data-lens> is shown. Hidden by default so
     nothing flashes before LensScript runs. */
  [data-lens-panel] {
    display: none;
  }
  :global(html[data-lens="all"]) [data-lens-panel="all"],
  :global(html[data-lens="data"]) [data-lens-panel="data"],
  :global(html[data-lens="ai"]) [data-lens-panel="ai"] {
    display: block;
  }
</style>
