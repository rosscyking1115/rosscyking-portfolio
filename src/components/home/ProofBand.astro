---
import { proofStats } from "../../lib/registry-stats";

/**
 * The full-bleed numeric band (design spec §04, home route).
 *
 *   "Proof numbers leave the hero and go edge-to-edge at 92px; the measure
 *    change is what fixes the flat scroll."
 *
 * ── WHY IT IS FULL-BLEED, WHICH IS THE WHOLE POINT ───────────────────────────
 * Audit finding 08 was the flatness: "eleven blocks arrive at the same width
 * off the same margin with roughly the same tonal weight. No motion system can
 * rescue that." Every section on this site sits inside the same 1152px
 * Container, so the page has exactly one measure from top to bottom and the eye
 * has nothing to catch on.
 *
 * This band is the only element on the home page that ignores it. Narrow text,
 * then a rule edge to edge — that change of measure is doing the work, not the
 * type size. Putting these numbers inside the container at 92px would make them
 * big and change nothing about the rhythm.
 *
 * It replaces the hero's right-hand rail (ProofStrip), where finding 05 found
 * them: "your three best numbers sit in the hero's right column at roughly a
 * third the size of the headline."
 *
 * ── DATED AND SOURCED ────────────────────────────────────────────────────────
 * The spec calls this "the first honest thing on the page", and a number
 * without a provenance is just a bigger claim. The date is stamped at BUILD
 * time from the build clock — not typed, and not remembered — so it says when
 * the count was actually taken rather than when someone last edited the copy.
 *
 * Every figure is `proofStats`, counted from the registry that
 * validate-projects.mjs gates. The same `testCount()` feeds the projects log's
 * ledger line, so the two surfaces cannot disagree (§03 R8).
 */
/**
 * `count` is the same figure as `value`, unformatted, so the script has a
 * number to animate towards without parsing "7,264" back out of the markup.
 * The rendered text is still the FINAL value — see the note on the span below.
 */
/**
 * `source` is what R8 asks these numbers to be able to answer — "numbers are
 * counted, not typed" — and the design pass gives it an interaction: hovering
 * or focusing a figure writes its source into a fixed slot beneath the band.
 *
 * Each string names the QUERY, not the answer. "Counted from the registry" is
 * what the footer already said and is true of all three; what a reader cannot
 * otherwise find out is which rows were counted and on what test.
 */
const items = [
  {
    value: String(proofStats.shipped),
    count: proofStats.shipped,
    label: "projects shipped",
    source: "Projects in registry.json whose status is “shipped”.",
  },
  {
    value: proofStats.tests.toLocaleString("en-GB"),
    count: proofStats.tests,
    label: "tests across them",
    source:
      "Every registry metric on a shipped project whose label contains “test”, summed.",
  },
  {
    value: String(proofStats.demos),
    count: proofStats.demos,
    label: "live demos",
    source: "Shipped projects carrying a demo URL in the registry.",
  },
];

/** The slot's resting text. Always present, always occupied — see below. */
const PROVENANCE_DEFAULT = "Hover or focus a figure for the source it is counted from.";

const counted = new Date().toLocaleDateString("en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
});
---

<section aria-label="Proof" class="bg-muted border-border border-y">
  {
    /*
      No Container, and no max-width. That is the measure change; wrapping this
      in the site's 1152px column would undo the only thing it is here to do.

      `divide-x` rather than three bordered cells: one hairline between each
      pair, none at the outer edges, so the band reads as one instrument rather
      than as three boxes that happen to be adjacent.
    */
  }
  <dl class="divide-border grid grid-cols-3 divide-x" data-proof-strip>
    {
      items.map((item) => (
        <div class="px-4 py-8 first:pl-6 last:pr-6 sm:px-8 sm:py-10 sm:first:pl-8 sm:last:pr-8">
          <dt class="sr-only">{item.label}</dt>
          <dd>
            {/*
              A BUTTON, AND ON A PHONE THAT IS THE WHOLE POINT. The design pass
              specifies "hovering or focusing a band figure writes its source
              into a fixed slot beneath the band" — and hover does not exist on
              a touch screen, while focus arrives there only via a tap. Built as
              a hover rule on a <span> this interaction would have been
              desktop-only on a site whose traffic is mostly phones, and it
              would have looked finished.

              So it is a real control: tap, click, or Tab to it, and the source
              appears. `aria-describedby` points at the slot, so a screen reader
              gets the provenance as part of the figure's description rather
              than as a paragraph somewhere else on the page.

              92px is R9's BAND figure and it is a CEILING. At 390px three
              cells of it is impossible, so the mobile step is 40px — the
              audit's own number, and its reasoning: "they are short and they
              read fine small". What that fixes is finding 06, three quarters of
              the phone home page being one shape: the figures used to STACK,
              spending roughly 430px on eleven characters.
            */}
            <button
              type="button"
              class="reticle-cursor block w-full cursor-pointer text-left"
              data-figure
              data-source={item.source}
              aria-describedby="proof-provenance"
            >
              <span
                class="text-foreground block font-mono text-[40px] leading-none font-medium tracking-[-0.03em] tabular-nums sm:text-7xl lg:text-[92px]"
                data-count-to={item.count}
              >
                {item.value}
              </span>{" "}
              <span class="text-muted-foreground mt-3 block font-mono text-[13px] tracking-[0.06em] uppercase sm:mt-4">
                {item.label}
              </span>
            </button>
          </dd>
        </div>
      ))
    }
  </dl>

  {
    /*
      BLANKED HERE, SYNCHRONOUSLY, IMMEDIATELY AFTER THE FIGURES.

      The counting itself lives in ArrivalScript.astro, with the observer that
      triggers it. This one line does not, and the split is deliberate: that
      script runs before this band exists, so its earliest hook is
      DOMContentLoaded — and a browser may well have painted before then. Blank
      the figures there and a reader on a slow connection sees the real numbers,
      then watches them drop to zero and climb back.

      An inline script blocks the parser where it sits, so the figures above
      cannot reach a paint un-blanked. `data-motion` is the gate: without it —
      no JavaScript, an error, or a reader who asked for less motion — this
      never runs and the final values stand, which is why they are what the
      server renders.
    */
  }
  <script is:inline>
    if (document.documentElement.hasAttribute("data-motion")) {
      document.querySelectorAll("[data-count-to]").forEach(function (el) {
        el.textContent = "0";
      });
    }
  </script>

  {
    /*
      THE PROVENANCE SLOT (design pass, home interactions).

      "The slot is always present and always occupied — default text 'Hover or
      focus a figure for the source it is counted from.' — so nothing shifts."

      Both halves of that are the design. ALWAYS PRESENT, because a slot that
      appears on hover pushes the whole page down at the moment the reader's
      pointer is somewhere specific, which is the worst possible time. ALWAYS
      OCCUPIED, because an empty reserved strip reads as a rendering fault.

      `min-h` rather than a fixed height: the longest source wraps to two lines
      at 390px, and clipping a sentence to protect a layout is the wrong way
      round. It is measured from the resting state, so nothing shifts on the
      widths where it fits — and where it does not, it grows once, on the page
      the reader is already looking at.

      `aria-live="polite"` so the source is announced when a figure takes focus
      rather than only being reachable by hunting for it.
    */
  }
  <p
    id="proof-provenance"
    data-provenance
    aria-live="polite"
    class="text-muted-foreground border-border ease-instrument flex min-h-5 items-center border-t px-6 py-3 font-mono text-xs transition-[color] duration-[var(--motion-state)] sm:px-8"
  >
    {PROVENANCE_DEFAULT}
  </p>

  <p
    class="text-muted-foreground border-border border-t px-6 py-2.5 font-mono text-xs sm:px-8"
  >
    Counted from the project registry, which gates every published number &middot; {
      counted
    }
  </p>

  <script is:inline>
    (() => {
      try {
        const slot = document.querySelector("[data-provenance]");
        const figures = document.querySelectorAll("[data-figure]");
        if (!slot || !figures.length) return;

        const resting = slot.textContent;
        const show = (event) => {
          slot.textContent = event.currentTarget.getAttribute("data-source") || resting;
        };
        const rest = () => {
          slot.textContent = resting;
        };

        for (const figure of figures) {
          figure.addEventListener("pointerenter", show);
          figure.addEventListener("focus", show);
          figure.addEventListener("click", show);
          figure.addEventListener("pointerleave", rest);
          figure.addEventListener("blur", rest);
        }
      } catch {
        // The slot keeps its resting sentence, which is true either way.
      }
    })();
  </script>
</section>
