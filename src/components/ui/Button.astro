---
import {
  buttonVariants,
  type ButtonSize,
  type ButtonVariant,
} from "../../lib/button-variants";

/**
 * Renders an <a> when `href` is given, a <button> otherwise. That replaces the
 * Next version's `asChild` + Radix Slot, which existed so a Button could wrap a
 * next/link — a React-only problem.
 */
interface Props {
  variant?: ButtonVariant;
  size?: ButtonSize;
  href?: string;
  type?: "button" | "submit" | "reset";
  class?: string;
  [key: string]: unknown;
}

const { variant, size, href, type = "button", class: className, ...rest } = Astro.props;
const classes = buttonVariants({ variant, size, class: className });
---

{
  href ? (
    <a href={href} class={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} {...rest}>
      <slot />
    </button>
  )
}
