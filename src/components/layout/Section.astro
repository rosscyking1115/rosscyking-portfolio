---
import { cn } from "../../lib/utils";
import Container from "./Container.astro";
import IndexMark from "./IndexMark.astro";

/**
 * Ported from src/components/layout/section.tsx.
 *
 * Astro has no equivalent of React's `HeadingTag = headingAs` dynamic element,
 * so the h1/h2 choice is a conditional below rather than a computed tag. Same
 * output, and it keeps `headingAs` honest — exactly one h1 per page.
 */
interface Props {
  size?: "sm" | "md" | "lg";
  containerSize?: "sm" | "md" | "lg";
  eyebrow?: string;
  /** When set, the eyebrow renders as a registration mark: `[ index ] —— eyebrow`. */
  index?: string;
  heading?: string;
  /** Heading semantic level. Use "h1" once per page; default "h2". */
  headingAs?: "h1" | "h2";
  description?: string;
  class?: string;
  id?: string;
  [key: string]: unknown;
}

const sizeClasses = {
  sm: "py-12 sm:py-16",
  md: "py-16 sm:py-24",
  lg: "py-20 sm:py-28",
} as const;

const {
  size = "md",
  containerSize = "lg",
  eyebrow,
  index,
  heading,
  headingAs = "h2",
  description,
  class: className,
  ...rest
} = Astro.props;

const headingClass =
  "font-display text-3xl font-semibold tracking-tight text-balance sm:text-4xl";
---

<section class={cn(sizeClasses[size], className)} {...rest}>
  <Container size={containerSize}>
    {
      (eyebrow || heading || description) && (
        <div class="mb-10 max-w-2xl">
          {index ? (
            <IndexMark mark={index} label={eyebrow} class="mb-3" />
          ) : (
            eyebrow && (
              <p class="text-muted-foreground mb-2 text-xs font-medium tracking-widest uppercase">
                {eyebrow}
              </p>
            )
          )}
          {heading &&
            (headingAs === "h1" ? (
              <h1 class={headingClass}>{heading}</h1>
            ) : (
              <h2 class={headingClass}>{heading}</h2>
            ))}
          {description && (
            <p class="text-muted-foreground mt-3 text-base leading-relaxed text-pretty">
              {description}
            </p>
          )}
        </div>
      )
    }
    <slot />
  </Container>
</section>
