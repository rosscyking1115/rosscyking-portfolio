---
import { cn } from "../../lib/utils";

/**
 * Registration mark — the site's one visual signature. A monospace index in
 * brackets, a 1px tick rule, and an optional label: `[ 01 ] —— Featured work`.
 * The mark is always *true* (priority, reading order, location), never
 * decoration, so it reads like the margin of a field notebook for evaluation
 * results. The tick rule is decorative and hidden from assistive tech.
 *
 * Ported verbatim from src/components/layout/index-mark.tsx.
 */
interface Props {
  /** The bracketed token — a number ("01") or a short label ("Ross King"). */
  mark: string;
  /** The label shown after the tick rule. Optional. */
  label?: string;
  class?: string;
}

const { mark, label, class: className } = Astro.props;

/**
 * A `label` slot takes precedence over the prop, so a caller can hang
 * attributes on the label element — the projects gallery uses it to mark the
 * count for its filter script to update.
 */
const hasLabelSlot = Astro.slots.has("label");
---

{
  /*
    `flex-wrap` plus `whitespace-nowrap` on the bracket, because at 320px
    `[ CONTACT ] —— SHEFFIELD, UK · GMT` broke mid-token: the closing bracket
    dropped to a second line on its own, leaving `[ CONTACT` above `]`. The mark
    is one glyph group and must never split; the LABEL is the part allowed to
    wrap to its own line when there is no room beside the rule.
  */
}
<div
  class={cn(
    "text-muted-foreground flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs tracking-wider uppercase",
    className,
  )}
>
  <span class="text-primary whitespace-nowrap">[ {mark} ]</span>
  <span class="bg-border h-px w-8 shrink-0" aria-hidden="true"></span>
  {hasLabelSlot ? <slot name="label" /> : label && <span>{label}</span>}
</div>
