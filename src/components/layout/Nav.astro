---
import { Menu, X } from "@lucide/astro";

import BrandIcon from "../icons/BrandIcon.astro";

import { buttonVariants } from "../../lib/button-variants";
import { siteConfig } from "../../lib/site-config";
import { cn } from "../../lib/utils";
import ThemeToggle from "../ThemeToggle.astro";
import Button from "../ui/Button.astro";
import Container from "./Container.astro";

/**
 * Ported from src/components/layout/nav.tsx.
 *
 * Two React concerns disappear rather than being reimplemented:
 *
 *   - `usePathname()` becomes `Astro.url.pathname`, resolved at build time. The
 *     active link is baked into the HTML instead of computed on hydration, so
 *     it is correct on first paint.
 *   - `useState` + `useEffect` for the mobile menu becomes ~15 lines of vanilla
 *     JS. The effect existed to lock body scroll while the menu is open; that
 *     is a direct DOM write either way, so React bought nothing here.
 *
 * Net result: the site's primary navigation ships zero framework JavaScript.
 */
const pathname = Astro.url.pathname;

const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);

const social = [
  { href: siteConfig.links.github, label: "GitHub", icon: "github" as const },
  { href: siteConfig.links.linkedin, label: "LinkedIn", icon: "linkedin" as const },
];
---

<header
  class="border-border/60 bg-background/80 supports-[backdrop-filter]:bg-background/60 sticky top-0 z-40 border-b backdrop-blur"
>
  <Container>
    <div class="flex h-16 items-center justify-between">
      <a
        href="/"
        class="font-display inline-block py-1 text-base font-bold tracking-tight transition-opacity hover:opacity-80"
      >
        {siteConfig.shortName}
      </a>

      <nav aria-label="Primary" class="hidden items-center gap-1 md:flex">
        {
          siteConfig.nav.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class={cn(
                "rounded-md px-3 py-2 text-sm transition-colors",
                isActive(item.href)
                  ? "text-foreground"
                  : "text-muted-foreground hover:text-foreground",
              )}
            >
              {item.label}
            </a>
          ))
        }
        <div class="border-border ml-2 flex items-center gap-2 border-l pl-3">
          <Button href="/contact" size="sm">Get in touch</Button>
          <ThemeToggle />
        </div>
      </nav>

      <div class="flex items-center gap-1 md:hidden">
        <ThemeToggle />
        <button
          type="button"
          id="menu-toggle"
          class={buttonVariants({ variant: "ghost", size: "icon" })}
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <Menu data-menu-icon="open" aria-hidden="true" />
          <X data-menu-icon="close" class="hidden" aria-hidden="true" />
        </button>
      </div>
    </div>
  </Container>

  {/* Mobile menu */}
  <div id="mobile-menu" hidden class="border-border/60 bg-background border-t md:hidden">
    <Container>
      <nav aria-label="Mobile" class="flex flex-col gap-1 py-4">
        {
          siteConfig.nav.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class={cn(
                "rounded-md px-3 py-3 text-base transition-colors",
                isActive(item.href)
                  ? "bg-muted text-foreground"
                  : "text-muted-foreground hover:bg-muted hover:text-foreground",
              )}
            >
              {item.label}
            </a>
          ))
        }
        <div class="mt-2 flex items-center gap-1 border-t pt-3">
          {
            social.map(({ href, label, icon }) => (
              <a
                href={href}
                aria-label={label}
                target="_blank"
                rel="noopener noreferrer"
                class="text-muted-foreground hover:bg-muted hover:text-foreground inline-flex size-10 items-center justify-center rounded-md transition-colors"
              >
                <BrandIcon name={icon} class="size-5" />
              </a>
            ))
          }
        </div>
      </nav>
    </Container>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const openIcon = toggle?.querySelector('[data-menu-icon="open"]');
  const closeIcon = toggle?.querySelector('[data-menu-icon="close"]');

  function setOpen(open: boolean) {
    if (!toggle || !menu) return;
    menu.hidden = !open;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    openIcon?.classList.toggle("hidden", open);
    closeIcon?.classList.toggle("hidden", !open);
    // Lock background scroll while the sheet is open.
    document.body.style.overflow = open ? "hidden" : "";
  }

  toggle?.addEventListener("click", () => {
    setOpen(menu ? menu.hidden !== false : true);
  });

  // A link closes the menu in the same action that navigates — the pattern the
  // Next app moved to when React 19 made "react to a pathname change in an
  // effect" a lint error.
  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setOpen(false));
  });

  // Escape closes it, which the React version never handled.
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu && !menu.hidden) setOpen(false);
  });
</script>
