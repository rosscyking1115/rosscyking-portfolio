---
import { ArrowUpRight } from "@lucide/astro";

import type { Certification } from "../../lib/certifications";
import Badge from "../ui/Badge.astro";

/**
 * Shared card list for the certifications and virtual-training sections.
 * Ported from the `CredentialList` helper inside src/app/about/page.tsx.
 */
interface Props {
  items: readonly Certification[];
}

const { items } = Astro.props;

/** "2026-06" → "Jun 2026". Same formatter as the Next page. */
const fmtMonth = (ym: string) =>
  new Date(`${ym}-01T00:00:00Z`).toLocaleDateString("en-GB", {
    month: "short",
    year: "numeric",
    timeZone: "UTC",
  });
---

<ul class="border-border divide-border mt-8 divide-y border-y">
  {
    items.map((cert) => (
      <li class="py-4">
        <div class="flex items-start justify-between gap-4">
          <div>
            <h3 class="font-display font-semibold">{cert.title}</h3>
            <div class="text-muted-foreground text-sm">{cert.issuer}</div>
          </div>
          <div class="text-muted-foreground shrink-0 font-mono text-xs">
            {fmtMonth(cert.date)}
          </div>
        </div>
        {cert.skills && cert.skills.length > 0 && (
          <div class="mt-3 flex flex-wrap gap-1.5">
            {cert.skills.map((skill) => (
              <Badge variant="outline">{skill}</Badge>
            ))}
          </div>
        )}
        {cert.url && (
          <a
            href={cert.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-primary mt-3 inline-flex items-center gap-1.5 text-sm font-medium"
          >
            Verify
            <ArrowUpRight class="size-3.5" aria-hidden="true" />
          </a>
        )}
      </li>
    ))
  }
</ul>
