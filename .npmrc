# npm needs --legacy-peer-deps because @hookform/resolvers pulls @typeschema/main,
# whose peerOptional @typeschema/zod still pins zod ^3.23.8. We are on zod 4 (the
# version astro@7 itself depends on, and the one `astro/zod` re-exports), so npm's
# strict resolver refuses an otherwise-fine tree. The @typeschema branch is never
# loaded at runtime — we use the zod resolver directly.
#
# Same class of problem as the root .npmrc, different cause. Revisit if
# @typeschema/zod ships zod 4 support.
legacy-peer-deps=true
